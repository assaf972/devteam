<% content_for :title, t('nav.projects') %>

<div class="level">
  <div class="level-left"><h1 class="fw-bold"><%= t('nav.projects') %></h1></div>
  <div class="level-right"><%= link_to t("buttons.new_project"), new_project_path, class: "btn btn-primary" %></div>
</div>

<div class="row">
  <% @projects.each do |project| %>
    <div class="col-6">
      <div class="card p-3 mb-3" style="overflow:hidden;">
        <div class="d-flex justify-content-between align-items-start gap-2">
          <div style="min-width:0;flex:1;">
              <p class="fw-bold fs-5 mb-1"><%= link_to project.name, project %></p>
              <p class="text-muted small mb-0" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= project.tech_stack %></p>
          </div>
          <div class="flex-shrink-0">
            <%= link_to "CI", ci_dashboard_project_path(project), class: "btn btn-secondary btn-sm is-light" %>
          </div>
        </div>
        <p class="fs-7 mb-3"><%= project.description&.truncate(120) %></p>
        <div class="d-flex flex-wrap gap-1">
          <span class="badge bg-info text-dark is-light"><%= project.tickets.where.not(status: [:done, :closed]).count %> open tickets</span>
          <span class="badge bg-warning-subtle text-warning-emphasis"><%= project.sprints.active.count %> active sprints</span>
          <span class="badge bg-success-subtle text-success"><%= project.ci_runs.passed.where(created_at: 7.days.ago..Time.current).count %> builds passed</span>
          <% if project.ci_runs.failed.where(created_at: 1.day.ago..Time.current).any? %>
            <span class="badge bg-danger">⚠ CI Failing</span>
          <% end %>
        </div>
        <div class="d-flex gap-2 align-items-end mt-3">
          <%= link_to "Tickets", project_tickets_path(project), class: "btn btn-secondary btn-sm is-info is-light" %>
          <%= link_to "Documents", project_documents_path(project), class: "btn btn-secondary btn-sm is-light" %>
          <%= link_to "Deployments", project_deployments_path(project), class: "btn btn-secondary btn-sm is-light" %>
        </div>
      </div>
    </div>
  <% end %>
</div>
