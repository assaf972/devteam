<% content_for :title, "Ticket ##{@ticket.id} – #{@ticket.title}" %>

<div class="row">
  <%# ─── Ticket detail ────────────────────────────────────────────────────── %>
  <div class="col-12">
    <div class="card p-3 mb-3">
      <div class="level">
        <div class="level-left">
          <div>
            <span class="badge bg-light text-dark">#<%= @ticket.id %></span>
            <%# Kind badge %>
            <%
              kind_color = case @ticket.kind
                when "story"      then "is-info"
                when "meta_story" then "is-link"
                when "bug_fix"    then "is-danger"
                when "hotfix"     then "is-danger is-dark"
                when "spike"      then "is-warning"
                else "is-light"
              end
            %>
            <span class="badge bg-secondary <%= kind_color %> ms-1"><%= @ticket.kind.humanize.gsub('_', ' ') %></span>
            <%# Level badge %>
            <%
              level_color = case @ticket.level
                when "trivial","simple"  then "is-success is-light"
                when "moderate"          then "is-warning is-light"
                when "complex","expert"  then "is-danger is-light"
                else "is-light"
              end
            %>
            <span class="badge bg-secondary <%= level_color %> ms-1" title="Complexity">⚙ <%= @ticket.level.capitalize %></span>
            <%= priority_tag(@ticket.priority) %>
            <%= status_tag(@ticket.status) %>
          </div>
        </div>
        <div class="level-right">
          <%= link_to t("common.actions.edit"), edit_ticket_path(@ticket), class: "btn btn-secondary btn-sm is-warning" %>
          <%= link_to t("common.delete"), ticket_path(@ticket), data: { turbo_method: :delete, turbo_confirm: t("common.confirm_delete") }, class: "btn btn-secondary btn-sm is-danger" %>
        </div>
      </div>

      <h1 class="fw-bold fs-4 mt-2"><%= @ticket.title %></h1>

      <%# Estimations row %>
      <% if @ticket.dev_estimate_hours.present? || @ticket.tester_estimate_hours.present? || @ticket.actual_hours.present? %>
        <div class="d-flex flex-wrap gap-1 mb-2">
          <% if @ticket.dev_estimate_hours.present? %>
            <span class="badge bg-info text-dark is-light">🧑‍💻 Dev: <%= @ticket.dev_estimate_hours %>h</span>
          <% end %>
          <% if @ticket.tester_estimate_hours.present? %>
            <span class="badge bg-warning-subtle text-warning-emphasis">🧪 QA: <%= @ticket.tester_estimate_hours %>h</span>
          <% end %>
          <% if @ticket.actual_hours.present? %>
            <span class="badge bg-success-subtle text-success-emphasis">⏱ Actual: <%= @ticket.actual_hours %></span>
          <% end %>
          <% if @ticket.estimated_by.present? %>
            <span class="badge bg-light text-dark">Estimator: <%= @ticket.estimated_by.display_name %></span>
          <% end %>
        </div>
      <% end %>

      <div class="content"><%= simple_format(@ticket.description) %></div>

      <%# How to Reproduce (bug_fix / hotfix only) %>
      <% if @ticket.bug_kind? && @ticket.how_to_reproduce.present? %>
        <div class="alert alert-warning p-3 mt-3">
          <p class="fw-semibold mb-1">🐛 How to Reproduce</p>
          <div class="trix-content fs-7">
            <%= sanitize @ticket.how_to_reproduce,
                  tags: %w[p ul ol li strong em h1 h2 h3 h4 blockquote pre code br a],
                  attributes: %w[href] %>
          </div>
        </div>
      <% end %>

      <% if @ticket.test_plan.present? %>
        <div class="card border-info p-3 mt-3">
          <p class="fw-semibold mb-1">🧪 Test Plan</p>
          <div class="trix-content fs-7">
            <%= sanitize @ticket.test_plan,
                  tags: %w[p ul ol li strong em h1 h2 h3 h4 blockquote pre code br a],
                  attributes: %w[href] %>
          </div>
        </div>
      <% end %>

      <div class="d-flex flex-wrap gap-1">
        <% @ticket.tag_list.each do |tag| %>
          <span class="badge bg-info text-dark is-light"><%= tag %></span>
        <% end %>
      </div>
    </div>

    <%# CI Runs %>
    <div class="card p-3 mb-3">
      <h3 class="subfw-bold"><%= t('nav.ci') %></h3>
      <% if @ci_runs.any? %>
        <table class="table w-100 fs-7">
          <thead><tr><th><%= t('table_headers.build') %></th><th><%= t('table_headers.branch') %></th><th><%= t('table_headers.status') %></th><th><%= t('table_headers.duration') %></th><th><%= t('table_headers.log') %></th></tr></thead>
          <tbody>
            <% @ci_runs.each do |run| %>
              <tr>
                <td><%= link_to "##{run.build_number}", run %></td>
                <td><code><%= run.branch_name %></code></td>
                <td><%= status_tag(run.status) %></td>
                <td><%= run.duration ? "#{run.duration} min" : "—" %></td>
                <td><% if run.log_url.present? %><%= link_to "Log", run.log_url, target: "_blank", class: "btn btn-secondary btn-sm is-light" %><% end %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="text-muted fs-7">No CI runs yet.</p>
      <% end %>
    </div>

    <%# Attachments %>
    <% if @ticket.attachments.attached? %>
      <div class="card p-3 mb-3">
        <h3 class="subfw-bold">📎 Attachments (<%= @ticket.attachments.count %>)</h3>
        <ul class="list-unstyled mb-0">
          <% @ticket.attachments.each do |attachment| %>
            <li class="d-flex align-items-center gap-2 py-1" style="border-bottom:1px solid #f5f5f5;">
              <span>📄</span>
              <%= link_to attachment.filename.to_s,
                    rails_blob_path(attachment, disposition: "attachment"),
                    target: "_blank",
                    class: "fs-7" %>
              <span class="text-muted fs-7 ms-auto">
                <%= number_to_human_size(attachment.byte_size) %>
                · <%= attachment.created_at.strftime('%d/%m/%Y') %>
              </span>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%# Comments %>
    <div class="card p-3 mb-3" id="comments">
      <h3 class="subfw-bold">Comments (<%= @comments.size %>)</h3>

      <%# Branch assignment notification for current user %>
      <% branch_notif = TicketBranchNotification
           .where(recipient: current_user)
           .where("params LIKE ?", "%\"ticket_id\":#{@ticket.id}%")
           .order(created_at: :desc).first %>
      <% if branch_notif %>
        <% git_cmd = branch_notif.params.is_a?(Hash) ? branch_notif.params["git_command"] : JSON.parse(branch_notif.params.to_s)["git_command"] rescue nil %>
        <% if git_cmd.present? %>
          <div class="alert alert-info is-light p-3 mb-4">
            <p class="fw-semibold mb-1">🔀 Your branch is ready</p>
            <code class="fs-7"><%= git_cmd %></code>
          </div>
        <% end %>
      <% end %>

      <% @comments.each do |comment| %>
        <article class="media mb-3" id="comment-<%= comment.id %>">
          <div class="media-content">
            <div class="content">
              <p>
                <strong><%= comment.author&.display_name || 'System' %></strong>
                <small class="text-muted ms-2"><%= time_ago_in_words(comment.created_at) %> ago</small>
                <br>
                <%= simple_format(h(comment.body)) %>
              </p>
            </div>
          </div>
          <% if comment.author == current_user || current_user.admin? %>
            <div class="media-right">
              <%= button_to "✕",
                    ticket_comment_path(@ticket, comment),
                    method: :delete,
                    data: { confirm: "Delete this comment?" },
                    class: "btn-close" %>
            </div>
          <% end %>
        </article>
      <% end %>

      <% if @comments.empty? %>
        <p class="text-muted fs-7 mb-4">No comments yet. Be the first!</p>
      <% end %>

      <%# Comment form — only for project members %>
      <% is_member = current_user.admin? || @ticket.project.members.include?(current_user) %>
      <% if is_member %>
        <hr>
        <%= form_with url: ticket_comments_path(@ticket), method: :post, local: true do |f| %>
          <div class="mb-3">
            <%= f.text_area :body, class: "textarea", rows: 3,
                  placeholder: "Add a comment… (supports plain text)" %>
          </div>
          <div>
            <%= f.submit "Comment", class: "btn btn-primary btn-sm" %>
          </div>
        <% end %>
      <% else %>
        <p class="text-muted fs-7">Join the project to comment.</p>
      <% end %>
    </div>
  </div>
</div>
