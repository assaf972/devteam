<%= form_with(model: [@project, ticket], class: "card p-3 mb-3") do |f| %>
  <% if ticket.errors.any? %>
    <div class="alert alert-danger is-light">
      <ul>
        <% ticket.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :title, class: "label" %>
    <div class="">
      <%= f.text_field :title, class: "input", required: true %>
    </div>
  </div>

  <div class="mb-3">
    <%= f.label :description, class: "label" %>
    <div class="">
      <%= f.text_area :description, class: "textarea", rows: 5 %>
    </div>
  </div>

  <%# ── Kind / Level / Status / Priority ──────────────────────────── %>
  <div class="row">
    <div class="col">
      <div class="mb-3">
        <%= f.label :kind, "Kind", class: "label" %>
        <div class="">
          <div class="select w-100">
            <%= f.select :kind, Ticket.kinds.keys.map { |k| [k.humanize.gsub("_", " "), k] } %>
          </div>
        </div>
      </div>
    </div>
    <div class="col">
      <div class="mb-3">
        <%= f.label :level, "Complexity Level", class: "label" %>
        <div class="">
          <div class="select w-100">
            <%= f.select :level, Ticket.levels.keys.map { |l| [l.capitalize, l] } %>
          </div>
        </div>
      </div>
    </div>
    <div class="col">
      <div class="mb-3">
        <%= f.label :status, class: "label" %>
        <div class="">
          <div class="select w-100">
            <%= f.select :status, Ticket.statuses.keys.map { |s| [s.humanize, s] } %>
          </div>
        </div>
      </div>
    </div>
    <div class="col">
      <div class="mb-3">
        <%= f.label :priority, class: "label" %>
        <div class="">
          <div class="select w-100">
            <%= f.select :priority, Ticket.priorities.keys.map { |p| [p.capitalize, p] } %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%# ── Estimations ─────────────────────────────────────────────── %>
  <div class="row">
    <div class="col-3">
      <div class="mb-3">
        <%= f.label :dev_estimate_hours, "Dev Estimate (h)", class: "label" %>
        <div class="">
          <%= f.number_field :dev_estimate_hours, class: "input", min: 0, step: 0.5, placeholder: "e.g. 8" %>
        </div>
      </div>
    </div>
    <div class="col-3">
      <div class="mb-3">
        <%= f.label :tester_estimate_hours, "QA Estimate (h)", class: "label" %>
        <div class="">
          <%= f.number_field :tester_estimate_hours, class: "input", min: 0, step: 0.5, placeholder: "e.g. 2" %>
        </div>
      </div>
    </div>
    <div class="col-3">
      <div class="mb-3">
        <%= f.label :story_points, "Story Points", class: "label" %>
        <div class="">
          <%= f.number_field :story_points, class: "input", min: 1, max: 100 %>
        </div>
      </div>
    </div>
    <div class="col-3">
      <div class="mb-3">
        <%= f.label :owner_id, "Reporter / Owner", class: "label" %>
        <div class="">
          <div class="select w-100">
            <%= f.select :owner_id, User.order(:name).map { |u| [u.display_name, u.id] }, { include_blank: "— None —" } %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%# ── Assignee / Sprint / PR ──────────────────────────────────── %>
  <div class="row">
    <div class="col">
      <div class="mb-3">
        <%= f.label :assignee_id, "Assignee", class: "label" %>
        <div class="">
          <div class="select w-100">
            <%= f.select :assignee_id, User.order(:name).map { |u| [u.display_name, u.id] }, { include_blank: "— Unassigned —" } %>
          </div>
        </div>
      </div>
    </div>
    <div class="col">
      <div class="mb-3">
        <%= f.label :sprint_id, "Sprint", class: "label" %>
        <div class="">
          <div class="select w-100">
            <%= f.select :sprint_id, @project.sprints.map { |s| [s.name, s.id] }, { include_blank: "— No Sprint —" } %>
          </div>
        </div>
      </div>
    </div>
    <div class="col">
      <div class="mb-3">
        <%= f.label :pr_url, "PR URL", class: "label" %>
        <div class="">
          <%= f.url_field :pr_url, class: "input", placeholder: "http://gitea.local/..." %>
        </div>
      </div>
    </div>
  </div>

  <%# ── How to Reproduce (shown for bug_fix and hotfix) ──────────── %>
  <div class="mb-3" id="how-to-reproduce-section"
       style="<%= ticket.bug_fix? || ticket.hotfix? ? '' : 'display:none;' %>">
    <%= f.label :how_to_reproduce, "How to Reproduce", class: "label" %>
    <div class="">
      <%= f.text_area :how_to_reproduce, class: "textarea", rows: 4,
            placeholder: "1. Go to...\n2. Click on...\n3. Observe..." %>
    </div>
    <p class="form-text text-muted text-muted">Steps to reproduce — for bug_fix and hotfix tickets.</p>
  </div>

  <%# ── Attachments ─────────────────────────────────────────────── %>
  <div class="mb-3">
    <%= f.label :attachments, "Attachments", class: "label" %>
    <div class="">
      <%= f.file_field :attachments, multiple: true, class: "input" %>
    </div>
    <p class="form-text text-muted text-muted">Spec documents, screenshots, design files.</p>
  </div>

  <div class="mb-3">
    <%= f.label :tag_list, "Tags (comma separated)", class: "label" %>
    <div class="">
      <%= f.text_field :tag_list, value: ticket.tag_list.to_s, class: "input", placeholder: "performance, auth, frontend" %>
    </div>
  </div>

  <div class="d-flex gap-2 align-items-end">
    <div class="">
      <%= f.submit ticket.new_record? ? "Create Ticket" : "Update Ticket", class: "btn btn-primary" %>
    </div>
    <div class="">
      <%= link_to "Cancel", @project, class: "btn btn-secondary" %>
    </div>
  </div>
<% end %>

<script>
  (function () {
    const kindSelect = document.querySelector('[name="ticket[kind]"]');
    const section    = document.getElementById('how-to-reproduce-section');
    if (!kindSelect || !section) return;
    function toggle() {
      const v = kindSelect.value;
      section.style.display = (v === 'bug_fix' || v === 'hotfix') ? '' : 'none';
    }
    kindSelect.addEventListener('change', toggle);
    toggle();
  })();
</script>
