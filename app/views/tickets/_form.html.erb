<%= simple_form_for(ticket.new_record? ? [@project, ticket] : ticket,
      html: { multipart: true, class: "card p-3 mb-3" }) do |f| %>

  <%= f.error_notification %>
  <%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].any? %>

  <%# ── Core ────────────────────────────────────────────────────────── %>
  <%= f.input :title, input_html: { class: "form-control" }, wrapper_html: { class: "mb-3" } %>

  <%= f.input :description,
        as: :text,
        input_html: { class: "form-control", rows: 5 },
        wrapper_html: { class: "mb-3" } %>

  <%# ── Kind / Level / Status / Priority ──────────────────────────── %>
  <div class="row mb-3">
    <div class="col">
      <%= f.input :kind,
            collection: Ticket.kinds.keys.map { |k| [k.humanize.gsub("_", " "), k] },
            selected: ticket.kind,
            include_blank: false,
            input_html: { class: "form-select", id: "ticket_kind_select" },
            label: "Kind" %>
    </div>
    <div class="col">
      <%= f.input :level,
            collection: Ticket.levels.keys.map { |l| [l.capitalize, l] },
            selected: ticket.level,
            include_blank: false,
            input_html: { class: "form-select" },
            label: "Complexity" %>
    </div>
    <div class="col">
      <%= f.input :status,
            collection: Ticket.statuses.keys.map { |s| [s.humanize, s] },
            selected: ticket.status,
            include_blank: false,
            input_html: { class: "form-select" } %>
    </div>
    <div class="col">
      <%= f.input :priority,
            collection: Ticket.priorities.keys.map { |p| [p.capitalize, p] },
            selected: ticket.priority,
            include_blank: false,
            input_html: { class: "form-select" } %>
    </div>
  </div>

  <%# ── People ──────────────────────────────────────────────────────── %>
  <div class="row mb-3">
    <div class="col">
      <%= f.input :assignee_id,
            label: "Assignee",
            collection: User.order(:name).map { |u| [u.display_name, u.id] },
            include_blank: "— Unassigned —",
            input_html: { class: "form-select" } %>
    </div>
    <div class="col">
      <%= f.input :owner_id,
            label: "Reporter / Owner",
            collection: User.order(:name).map { |u| [u.display_name, u.id] },
            include_blank: "— None —",
            input_html: { class: "form-select" } %>
    </div>
  </div>

  <%# ── Sprint / Milestone ──────────────────────────────────────────── %>
  <div class="row mb-3">
    <div class="col">
      <%= f.input :sprint_id,
            label: "Sprint",
            collection: @project.sprints.order(:name).map { |s| [s.name, s.id] },
            include_blank: "— No Sprint —",
            input_html: { class: "form-select" } %>
    </div>
    <div class="col">
      <%= f.input :milestone_id,
            label: "Milestone",
            collection: @project.milestones.order(:name).map { |m| [m.name, m.id] },
            include_blank: "— No Milestone —",
            input_html: { class: "form-select" } %>
    </div>
  </div>

  <%# ── Estimations ─────────────────────────────────────────────────── %>
  <div class="row mb-3">
    <div class="col-3">
      <%= f.input :story_points,
            label: "Story Points",
            input_html: { class: "form-control", min: 1, max: 100 } %>
    </div>
    <div class="col-3">
      <%= f.input :actual_velocity,
            label: "Actual Velocity (pts)",
            input_html: { class: "form-control", min: 0 } %>
    </div>
    <div class="col-3">
      <%= f.input :dev_estimate_hours,
            label: "Dev Estimate (h)",
            input_html: { class: "form-control", min: 0, step: 0.5 } %>
    </div>
    <div class="col-3">
      <%= f.input :tester_estimate_hours,
            label: "QA Estimate (h)",
            input_html: { class: "form-control", min: 0, step: 0.5 } %>
    </div>
  </div>
  <div class="row mb-3">
    <div class="col-3">
      <%= f.input :actual_hours,
            label: "Actual Work (e.g. 2d 4h)",
            input_html: { class: "form-control", placeholder: "2d 4h" } %>
    </div>
    <div class="col-3">
      <%= f.input :pr_url,
            label: "PR URL",
            as: :url,
            input_html: { class: "form-control", placeholder: "http://gitea.local/..." } %>
    </div>
  </div>

  <%# ── How to Reproduce (bug_fix / hotfix only) ────────────────────── %>
  <div class="mb-3" id="how-to-reproduce-section"
       style="<%= ticket.bug_fix? || ticket.hotfix? ? '' : 'display:none;' %>">
    <label class="form-label fw-semibold">How to Reproduce</label>
    <%= f.hidden_field :how_to_reproduce, id: "ticket_how_to_reproduce_input" %>
    <trix-editor input="ticket_how_to_reproduce_input" class="trix-content" style="min-height:120px;"></trix-editor>
    <div class="form-text">Steps to reproduce — for bug_fix and hotfix tickets.</div>
  </div>

  <%# ── Test Plan ───────────────────────────────────────────────────── %>
  <div class="mb-3">
    <label class="form-label fw-semibold">Test Plan</label>
    <%= f.hidden_field :test_plan, id: "ticket_test_plan_input" %>
    <trix-editor input="ticket_test_plan_input" class="trix-content" style="min-height:120px;"></trix-editor>
    <div class="form-text">Describe how this story will be tested.</div>
  </div>

  <%# ── Tags ────────────────────────────────────────────────────────── %>
  <%= f.input :tag_list,
        label: "Tags (comma separated)",
        value: ticket.tag_list.to_s,
        input_html: { class: "form-control", placeholder: "performance, auth, frontend" },
        wrapper_html: { class: "mb-3" } %>

  <%# ── Attachments ─────────────────────────────────────────────────── %>
  <div class="mb-3">
    <%= f.input :attachments,
          as: :file,
          input_html: { multiple: true, class: "form-control" },
          hint: "Spec documents, screenshots, design files. Multiple files allowed." %>

    <% if ticket.attachments.attached? %>
      <div class="mt-2">
        <p class="fw-semibold fs-7 mb-1">Current attachments:</p>
        <ul class="list-unstyled fs-7">
          <% ticket.attachments.each do |attachment| %>
            <li>
              📎 <%= link_to attachment.filename.to_s, rails_blob_path(attachment, disposition: "attachment"), target: "_blank" %>
              <span class="text-muted ms-1">(<%= number_to_human_size(attachment.byte_size) %>)</span>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </div>

  <%# ── Actions ────────────────────────────────────────────────────── %>
  <div class="d-flex gap-2 align-items-center">
    <%= f.button :submit,
          ticket.new_record? ? "Create Ticket" : "Update Ticket",
          class: "btn btn-primary" %>
    <%= link_to "Cancel", ticket.new_record? ? project_path(@project) : ticket_path(ticket),
          class: "btn btn-secondary" %>
  </div>

<% end %>

<script nonce="<%= request.content_security_policy_nonce %>">
  (function () {
    // Trix: load existing HTML content into each editor
    document.addEventListener("trix-initialize", function(event) {
      var editor  = event.target;
      var inputId = editor.getAttribute("input");
      var hidden  = document.getElementById(inputId);
      if (hidden && hidden.value) { editor.editor.loadHTML(hidden.value); }
    });

    // Toggle how-to-reproduce section based on ticket kind
    const kindSelect = document.getElementById("ticket_kind_select");
    const section    = document.getElementById("how-to-reproduce-section");
    if (!kindSelect || !section) return;
    function toggle() {
      const v = kindSelect.value;
      section.style.display = (v === "bug_fix" || v === "hotfix") ? "" : "none";
    }
    kindSelect.addEventListener("change", toggle);
  })();
</script>
