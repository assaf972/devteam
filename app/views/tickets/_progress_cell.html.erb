<%# Compact task progress + estimation for a ticket row. locals: ticket %>
<% if ticket.tasks_count.to_i.positive? %>
  <div style="min-width:96px;">
    <div class="progress" style="height:5px;">
      <div class="progress-bar bg-info" style="width:<%= ticket.tasks_progress_in_percents %>%"></div>
    </div>
    <span class="fs-7 text-muted">
      <%= ticket.tasks_progress_in_percents %>% · <%= ticket.completed_tasks_count %>/<%= ticket.tasks_count %>
      <% if ticket.total_tasks_estimation.to_f.positive? %> · <%= ticket.total_tasks_estimation %>h<% end %>
    </span>
  </div>
<% else %>
  <span class="text-muted fs-7">—</span>
<% end %>
