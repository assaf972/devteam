<% content_for :title, @document.title %>

<div class="level">
  <div class="level-left">
    <div>
      <h1 class="fw-bold"><%= @document.title %></h1>
      <p class="subfw-bold is-7 text-muted">
        <%= t("documents.types.#{@document.doc_type}") %> · v<%= @document.version_number.presence || '1.0' %>
        · by <%= @document.author&.display_name %> · <%= @document.updated_at.strftime('%d/%m/%Y %H:%M') %>
      </p>
    </div>
  </div>
  <div class="level-right">
    <%= link_to "Edit", edit_document_path(@document), class: "btn btn-secondary btn-sm is-warning" %>
    <%= link_to "Delete", document_path(@document), data: { turbo_method: :delete, turbo_confirm: "Delete?" }, class: "btn btn-secondary btn-sm is-danger" %>
  </div>
</div>

<% if @document.summary.present? %>
  <div class="alert alert-info is-light mb-4">
    <strong>Summary:</strong> <%= @document.summary %>
  </div>
<% end %>

<div class="card p-3 mb-3 content">
  <%# Render markdown content %>
  <%= raw(Redcarpet::Markdown.new(Redcarpet::Render::HTML.new(safe_links_only: true), autolink: true, tables: true, fenced_code_blocks: true).render(@document.content || '')) %>
</div>

<% if @document.tag_list.any? %>
  <div class="d-flex flex-wrap gap-1">
    <% @document.tag_list.each do |tag| %><span class="badge bg-info text-dark is-light"><%= tag %></span><% end %>
  </div>
<% end %>
