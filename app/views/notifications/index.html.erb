<% content_for :title, "Notifications" %>

<div class="level">
  <div class="level-left">
    <h1 class="fw-bold">Notifications</h1>
  </div>
  <div class="level-right d-flex gap-2">
    <%= link_to t("buttons.new_notification"), new_notification_path, class: "btn btn-primary" %>
    <% if @notifications.any? { |n| !n.read? } %>
      <%= link_to "Mark all read", mark_all_read_notifications_path,
            data: { turbo_method: :post },
            class: "btn btn-secondary is-light" %>
    <% end %>
  </div>
</div>

<div class="card p-3">
  <% if @notifications.blank? %>
    <p class="text-muted mb-0">No notifications available.</p>
  <% else %>
    <div class="table-responsive">
      <table class="table is-fullwidth">
        <thead>
          <tr>
            <th>Status</th>
            <th>Message</th>
            <th>Error</th>
            <th>Created</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @notifications.each do |notification| %>
            <tr>
              <td>
                <% if notification.read? %>
                  <span class="badge bg-secondary is-light">Read</span>
                <% else %>
                  <span class="badge bg-warning text-dark">Unread</span>
                <% end %>
              </td>
              <td><%= notification.message_text.truncate(120) %></td>
              <td>
                <% if notification.error_text.present? %>
                  <span class="badge bg-danger">Exception</span>
                <% else %>
                  <span class="text-muted">-</span>
                <% end %>
              </td>
              <td><%= notification.created_at.strftime("%Y-%m-%d %H:%M") %></td>
              <td class="text-end">
                <div class="d-inline-flex gap-1">
                  <%= link_to t("common.view"), notification_path(notification), class: "btn btn-sm btn-secondary is-light" %>
                  <%= link_to t("common.actions.edit"), edit_notification_path(notification), class: "btn btn-sm btn-secondary is-light" %>
                  <% unless notification.read? %>
                    <%= link_to "Mark read", mark_read_notification_path(notification),
                          data: { turbo_method: :patch },
                          class: "btn btn-sm btn-secondary is-light" %>
                  <% end %>
                  <%= link_to t("common.delete"), notification_path(notification),
                    data: { turbo_method: :delete, turbo_confirm: t("common.confirm_delete") },
                        class: "btn btn-sm btn-danger" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
