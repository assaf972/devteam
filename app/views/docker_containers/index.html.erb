<% content_for(:title) { "Docker Containers" } %>

<%# ── Log modal ─────────────────────────────────────────────────────────────── %>
<div class="modal fade" id="logsModal" tabindex="-1" aria-labelledby="logsModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header bg-dark text-white py-2">
        <h6 class="modal-title mb-0 fw-bold" id="logsModalLabel">📜 Container logs</h6>
        <div class="d-flex align-items-center gap-2 ms-auto">
          <button id="logs-refresh-btn" class="btn btn-sm btn-outline-light py-0">↻ Refresh</button>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
      </div>
      <div class="modal-body p-0">
        <pre id="logs-content" class="m-0 p-3" style="background:#111;color:#c5dbd2;font-size:0.78rem;min-height:340px;max-height:60vh;overflow-y:auto;white-space:pre-wrap;word-break:break-all;"></pre>
      </div>
    </div>
  </div>
</div>

<%# ── Header ────────────────────────────────────────────────────────────────── %>
<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
  <div>
    <h1 class="fw-bold mb-1">🐳 Docker Containers</h1>
    <p class="text-muted fs-7 mb-0">Manage running containers across your servers</p>
  </div>

  <%# ── Server filter ── %>
  <% if @servers.any? %>
    <%= form_with url: docker_containers_path, method: :get, local: true, class: "d-flex align-items-center gap-2" do |f| %>
      <label class="fw-semibold fs-7 text-nowrap mb-0" for="server_select">🖥️ Server:</label>
      <%= f.select :server,
            @servers.map { |s| [ "#{s.server_name.presence || s.ip_address}  (#{s.ip_address})", s.ip_address ] },
            {},
            id: "server_select",
            class: "form-select form-select-sm",
            style: "min-width:260px;",
            onchange: "this.form.submit()" %>
    <% end %>
  <% end %>
</div>

<% if @servers.empty? %>
  <div class="card p-4 text-center text-muted">
    <p class="fs-5 mb-1">No servers registered yet.</p>
    <p class="fs-7">Servers appear here once they start sending heartbeats to DevTeam Hub.</p>
    <%= link_to "View Servers", servers_path, class: "btn btn-outline-secondary btn-sm mt-2" %>
  </div>

<% elsif @selected_ip.present? %>

  <%# ── Selected server info bar ── %>
  <% selected_server = @servers.find { |s| s.ip_address == @selected_ip } %>
  <% if selected_server %>
    <div class="d-flex align-items-center gap-3 mb-4 px-3 py-2 rounded border bg-light fs-7 flex-wrap">
      <span class="fw-semibold"><%= selected_server.server_name.presence || selected_server.ip_address %></span>
      <span class="text-muted"><code><%= selected_server.ip_address %></code></span>
      <% if selected_server.server_os.present? %>
        <span class="text-muted">· <%= selected_server.server_os %></span>
      <% end %>
      <span class="badge <%= selected_server.health_badge_class %>"><%= selected_server.health.humanize %></span>
      <% if @docker && !@docker.configured? %>
        <span class="badge bg-warning text-dark ms-auto">⚠ Demo mode — set DOCKER_API_BASE to connect a real host</span>
      <% end %>
      <%= link_to "📊 Telemetry", server_path(ip: @selected_ip), class: "btn btn-outline-secondary btn-sm ms-auto py-0" %>
    </div>
  <% end %>

  <%# ── Stat row ── %>
  <% running_count  = @containers.count { |c| c["state"] == "running" } %>
  <% stopped_count  = @containers.count { |c| c["state"] == "exited" } %>
  <% other_count    = @containers.size - running_count - stopped_count %>
  <div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
      <div class="card text-center p-3">
        <div class="fw-bold fs-1 text-success"><%= running_count %></div>
        <div class="text-muted fs-7 text-uppercase fw-semibold">Running</div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card text-center p-3">
        <div class="fw-bold fs-1 text-secondary"><%= stopped_count %></div>
        <div class="text-muted fs-7 text-uppercase fw-semibold">Stopped</div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card text-center p-3">
        <div class="fw-bold fs-1 <%= other_count > 0 ? 'text-warning' : 'text-muted' %>"><%= other_count %></div>
        <div class="text-muted fs-7 text-uppercase fw-semibold">Other</div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card text-center p-3">
        <div class="fw-bold fs-1"><%= @containers.size %></div>
        <div class="text-muted fs-7 text-uppercase fw-semibold">Total</div>
      </div>
    </div>
  </div>

  <%# ── Containers table ── %>
  <% if @containers.empty? %>
    <div class="card p-4 text-center text-muted">No containers found on this server.</div>
  <% else %>
    <div class="card p-0 shadow-sm">
      <div class="d-flex align-items-center justify-content-between px-3 py-2 border-bottom">
        <span class="fw-bold fs-6">Containers on <code><%= @selected_ip %></code></span>
        <span class="badge bg-secondary"><%= @containers.size %></span>
      </div>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 fs-7">
          <thead class="table-light">
            <tr>
              <th style="width:180px;">Name</th>
              <th>Image</th>
              <th style="width:130px;">Ports</th>
              <th style="width:80px;">State</th>
              <th>Uptime / Status</th>
              <th class="text-end" style="width:220px;">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @containers.each do |c| %>
              <%
                state   = c["state"].to_s
                running = state == "running"
                restart = state == "restarting"
                exited  = state == "exited"
                state_class = running ? "bg-success" : restart ? "bg-warning text-dark" : "bg-secondary"
              %>
              <tr>
                <td>
                  <span class="fw-semibold"><%= c["name"] %></span>
                </td>
                <td>
                  <code class="fs-8 text-muted"><%= c["image"] %></code>
                </td>
                <td class="text-muted">
                  <%= c["ports"].presence || "—" %>
                </td>
                <td>
                  <span class="badge <%= state_class %>"><%= state %></span>
                </td>
                <td class="text-muted fs-8"><%= c["status"] %></td>
                <td class="text-end text-nowrap">
                  <%# Start — only when stopped %>
                  <% unless running || restart %>
                    <%= button_to docker_containers_action_path,
                          params: { server: @selected_ip, container: c["name"], verb: "start" },
                          method: :post,
                          class: "btn btn-sm btn-success py-0 me-1",
                          title: "Start",
                          form: { style: "display:inline;" } do %>
                      ▶ Start
                    <% end %>
                  <% end %>

                  <%# Stop — only when running %>
                  <% if running || restart %>
                    <%= button_to docker_containers_action_path,
                          params: { server: @selected_ip, container: c["name"], verb: "stop" },
                          method: :post,
                          class: "btn btn-sm btn-outline-danger py-0 me-1",
                          title: "Stop",
                          data: { confirm: "Stop #{c['name']}?" },
                          form: { style: "display:inline;" } do %>
                      ⏹ Stop
                    <% end %>
                  <% end %>

                  <%# Restart — always available %>
                  <%= button_to docker_containers_action_path,
                        params: { server: @selected_ip, container: c["name"], verb: "restart" },
                        method: :post,
                        class: "btn btn-sm btn-outline-secondary py-0 me-1",
                        title: "Restart",
                        data: { confirm: "Restart #{c['name']}?" },
                        form: { style: "display:inline;" } do %>
                    ↺ Restart
                  <% end %>

                  <%# Logs %>
                  <button class="btn btn-sm btn-outline-dark py-0"
                          title="View logs"
                          data-container="<%= c['name'] %>"
                          data-server="<%= @selected_ip %>"
                          data-logs-url="<%= docker_containers_logs_path(server: @selected_ip, container: c['name']) %>"
                          onclick="openLogs(this)">
                    📜 Logs
                  </button>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>

<% end %>

<script>
  function openLogs(btn) {
    const url       = btn.dataset.logsUrl;
    const container = btn.dataset.container;
    const modal     = new bootstrap.Modal(document.getElementById('logsModal'));
    const pre       = document.getElementById('logs-content');
    const title     = document.getElementById('logsModalLabel');
    const refreshBtn = document.getElementById('logs-refresh-btn');

    title.textContent = '📜 Logs — ' + container;
    pre.textContent   = 'Loading…';
    modal.show();

    function fetchLogs() {
      pre.textContent = 'Loading…';
      fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
        .then(r => r.text())
        .then(t => { pre.textContent = t; pre.scrollTop = pre.scrollHeight; })
        .catch(e => { pre.textContent = 'Error: ' + e; });
    }

    fetchLogs();
    refreshBtn.onclick = fetchLogs;
  }
</script>
