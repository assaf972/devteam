<% content_for :title, @sprint.name %>

<%# Header %>
<div class="level">
  <div class="level-left">
    <div>
      <nav class="breadcrumb is-small"><ul>
        <li><%= link_to @project.name, @project %></li>
        <li><%= link_to "Sprints", project_sprints_path(@project) %></li>
        <li class="is-active"><a><%= @sprint.name %></a></li>
      </ul></nav>
      <h1 class="fw-bold mb-1"><%= @sprint.name %></h1>
      <p class="text-muted fs-7">
        <%= @sprint.start_date.strftime("%d %b %Y") %> – <%= @sprint.end_date.strftime("%d %b %Y") %>
        · <%= @sprint.duration_days %> days
        <% if @sprint.active? %>
          · <strong class="text-success"><%= @sprint.days_remaining %> days remaining</strong>
        <% end %>
      </p>
    </div>
  </div>
  <div class="level-right d-flex gap-2">
    <% status_colors = { "planning" => "bg-info", "active" => "bg-success", "completed" => "bg-secondary", "cancelled" => "bg-danger" } %>
    <span class="badge <%= status_colors[@sprint.status] || "bg-secondary" %>"><%= @sprint.status.humanize %></span>
    <%= link_to "💬 Channels", project_path(@project, anchor: "channels"), class: "btn btn-secondary btn-sm is-light" %>
    <%= link_to "📊 Dashboard", dashboard_sprint_path(@sprint), class: "btn btn-primary btn-sm is-light" %>
    <%= button_to "📊 AI Estimation", tools_ai_estimation_analysis_path(sprint_id: @sprint.id),
          method: :post, class: "btn btn-secondary btn-sm" %>
    <%= link_to t("common.actions.edit"), edit_sprint_path(@sprint), class: "btn btn-secondary btn-sm is-warning is-light" %>
        <%= button_to t("common.delete"), sprint_path(@sprint), method: :delete,
          data: { turbo_confirm: t("common.confirm_delete") },
          class: "btn btn-secondary btn-sm is-danger is-light" %>
  </div>
</div>

<%# Stats row %>
<div class="row g-2 mb-4">
  <div class="col-6 col-md-3">
    <div class="card p-3 text-center">
      <div class="fw-bold fs-4"><%= @tickets.count %></div>
      <div class="text-muted fs-7">Tickets</div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card p-3 text-center">
      <div class="fw-bold fs-4"><%= @sprint.progress_percent %>%</div>
      <div class="text-muted fs-7">Done</div>
      <div class="progress mt-1" style="height:4px;">
        <div class="progress-bar bg-success" style="width:<%= @sprint.progress_percent %>%"></div>
      </div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card p-3 text-center">
      <div class="fw-bold fs-4"><%= @pull_requests.count %></div>
      <div class="text-muted fs-7">Pull Requests</div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card p-3 text-center">
      <div class="fw-bold fs-4"><%= @meetings.count %></div>
      <div class="text-muted fs-7">Meetings</div>
    </div>
  </div>
</div>

<%# ── Live AI sprint analysis (lazy-loaded from the local Ollama LLM) ──────── %>
<turbo-frame id="ai_sprint_analysis"
             src="<%= tools_ai_sprint_analysis_path(sprint_id: @sprint.id) %>"
             loading="lazy">
  <div class="card p-3 mb-4" style="border-left:4px solid #7048e8;">
    <span class="text-muted fs-7">🤖 <%= t("ai.analyzing") %> <span class="spinner-border spinner-border-sm ms-1"></span></span>
  </div>
</turbo-frame>

<% if @sprint.goals.present? %>
  <div class="alert alert-info is-light mb-4">
    <strong>🎯 Goals:</strong> <%= simple_format(@sprint.goals) %>
  </div>
<% end %>

<% if @sprint.things_that_went_right.present? || @sprint.things_to_improve.present? %>
  <div class="row mb-4">
    <% if @sprint.things_that_went_right.present? %>
      <div class="col-md-6">
        <div class="card p-3 h-100 border-success">
          <h5 class="fw-bold text-success mb-2">✅ Things That Went Right</h5>
          <div class="trix-content">
            <%= sanitize @sprint.things_that_went_right,
                  tags: %w[p ul ol li strong em h1 h2 h3 h4 blockquote pre code br a],
                  attributes: %w[href] %>
          </div>
        </div>
      </div>
    <% end %>
    <% if @sprint.things_to_improve.present? %>
      <div class="col-md-6">
        <div class="card p-3 h-100 border-warning">
          <h5 class="fw-bold text-warning mb-2">🔧 Things to Improve</h5>
          <div class="trix-content">
            <%= sanitize @sprint.things_to_improve,
                  tags: %w[p ul ol li strong em h1 h2 h3 h4 blockquote pre code br a],
                  attributes: %w[href] %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% end %>

<div class="row">
  <div class="col-8">

    <%# Assigned / planned tickets %>
    <div class="card p-3 mb-3">
      <div class="level mb-2">
        <div class="level-left"><h3 class="fw-bold fs-5 mb-0">🎫 Assigned Tickets (<%= @assigned_tickets.size %>)</h3></div>
        <div class="level-right"><%= link_to "All Tickets", project_tickets_path(@project), class: "fs-7 text-muted" %></div>
      </div>
      <% if @assigned_tickets.any? %>
        <table class="table table-hover w-100 fs-7 align-middle mb-0">
          <thead>
            <tr>
              <th>Name</th>
              <th>Assignee</th>
              <th>Description</th>
              <th style="min-width:170px;">Progress</th>
            </tr>
          </thead>
          <tbody>
            <% @assigned_tickets.each do |ticket| %>
              <%
                total_estimate = (ticket.dev_estimate_hours || 0).to_f + (ticket.tester_estimate_hours || 0).to_f
                actual = ticket.actual_hours_in_hours || 0
                if total_estimate > 0
                  pct = [ (actual / total_estimate * 100).round, 100 ].min
                  bar_color = actual > total_estimate ? "bg-danger" : (pct >= 80 ? "bg-warning" : "bg-success")
                else
                  pct = 0
                  bar_color = "bg-secondary"
                end
              %>
              <tr>
                <td>
                  <%= link_to ticket.title.truncate(50), ticket_path(ticket), class: "fw-semibold text-decoration-none" %>
                  <div class="mt-1"><%= status_tag(ticket.status) %> <%= priority_tag(ticket.priority) if ticket.priority %></div>
                  <div class="d-flex flex-wrap gap-1 mt-1"><%= render "tickets/progress_badges", ticket: ticket %></div>
                </td>
                <td>
                  <% if ticket.assignee %>
                    <span class="d-inline-flex align-items-center gap-1">
                      <%= user_avatar(ticket.assignee, size: 24, bg: '#4a90d9') %>
                      <%= ticket.assignee.display_name %>
                    </span>
                  <% else %>
                    <span class="text-muted">— Unassigned —</span>
                  <% end %>
                </td>
                <td class="text-muted" style="max-width:260px;">
                  <%= ticket.description.present? ? truncate(strip_tags(ticket.description), length: 100) : "—" %>
                </td>
                <td>
                  <div class="d-flex align-items-center gap-2">
                    <div class="progress flex-grow-1" style="height:6px;">
                      <div class="progress-bar <%= bar_color %>" style="width:<%= pct %>%"></div>
                    </div>
                    <span class="text-muted" style="white-space:nowrap;"><%= actual %>h / <%= total_estimate %>h</span>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="text-muted fs-7 mb-0">No estimated tickets in this sprint yet.</p>
      <% end %>
    </div>

    <%# Tickets needing evaluation / refinement %>
    <div class="card p-3 mb-3" id="needs-refinement">
      <h3 class="fw-bold fs-5 mb-3">🔍 Needs Evaluation &amp; Refinement (<%= @refinement_tickets.size %>)</h3>
      <% if @refinement_tickets.any? %>
        <table class="table table-hover w-100 fs-7 align-middle mb-0">
          <thead>
            <tr>
              <th>Name</th>
              <th>Owner / Assignee</th>
              <th>Status</th>
              <th>Missing</th>
              <th class="text-end"></th>
            </tr>
          </thead>
          <tbody>
            <% @refinement_tickets.each do |ticket| %>
              <tr>
                <td><%= link_to ticket.title.truncate(50), ticket_path(ticket), class: "fw-semibold text-decoration-none" %></td>
                <td><%= (ticket.owner || ticket.assignee)&.display_name || "—" %></td>
                <td><%= status_tag(ticket.status) %></td>
                <td>
                  <div class="d-flex flex-wrap gap-1">
                    <% if ticket.story_points.blank? %>
                      <span class="badge bg-warning-subtle text-warning-emphasis">No story points</span>
                    <% end %>
                    <% if ticket.dev_estimate_hours.blank? %>
                      <span class="badge bg-warning-subtle text-warning-emphasis">No dev estimate</span>
                    <% end %>
                    <% if ticket.tester_estimate_hours.blank? %>
                      <span class="badge bg-light text-dark">No QA estimate</span>
                    <% end %>
                  </div>
                </td>
                <td class="text-end">
                  <%= link_to "Refine →", edit_ticket_path(ticket), class: "btn btn-outline-primary btn-sm" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="text-muted fs-7 mb-0">All sprint tickets have been estimated and refined. 🎉</p>
      <% end %>
    </div>

    <%# Pull Requests %>
    <div class="card p-3 mb-3">
      <h3 class="fw-bold fs-5 mb-3">🔀 Pull Requests (<%= @pull_requests.count %>)</h3>
      <% if @pull_requests.any? %>
        <table class="table w-100 fs-7">
          <thead><tr><th><%= t('table_headers.id') %></th><th><%= t('table_headers.title') %></th><th><%= t('table_headers.ticket') %></th><th><%= t('table_headers.status') %></th></tr></thead>
          <tbody>
            <% @pull_requests.each do |pr| %>
              <tr>
                <td><code>#<%= pr.pr_number %></code></td>
                <td>
                  <% if pr.gitea_url.present? %>
                    <%= link_to pr.title.truncate(50), pr.gitea_url, target: "_blank", rel: "noopener" %>
                  <% else %>
                    <%= pr.title.truncate(50) %>
                  <% end %>
                </td>
                <td><% if pr.ticket %><%= link_to pr.ticket.title.truncate(30), ticket_path(pr.ticket) %><% else %>—<% end %></td>
                <td><%= status_tag(pr.status) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="text-muted fs-7">No pull requests linked to this sprint yet.</p>
      <% end %>
    </div>

    <%# Comments %>
    <div class="card p-3 mb-3" id="comments">
      <h3 class="fw-bold fs-5 mb-3">💬 Comments (<%= @comments.size %>)</h3>

      <% @comments.each do |comment| %>
        <article class="media mb-3" id="comment-<%= comment.id %>">
          <div class="media-content">
            <div class="content">
              <p>
                <strong><%= comment.author&.display_name || "System" %></strong>
                <small class="text-muted ms-2"><%= time_ago_in_words(comment.created_at) %> ago</small>
                <br>
                <%= simple_format(h(comment.body)) %>
              </p>
            </div>
          </div>
          <% if comment.author == current_user || current_user.admin? %>
            <div class="media-right">
              <%= button_to "✕",
                    sprint_comment_path(@sprint, comment),
                    method: :delete,
                    data: { turbo_confirm: "Delete this comment?" },
                    class: "btn-close" %>
            </div>
          <% end %>
        </article>
      <% end %>

      <% if @comments.empty? %>
        <p class="text-muted fs-7 mb-3">No comments yet.</p>
      <% end %>

      <hr>
      <%= form_with url: sprint_comments_path(@sprint), method: :post, local: true do |f| %>
        <div class="mb-2">
          <%= f.text_area :body, class: "form-control", rows: 3, placeholder: "Add a comment…" %>
        </div>
        <%= f.submit "Comment", class: "btn btn-primary btn-sm" %>
      <% end %>
    </div>

  </div><%# /col-8 %>

  <div class="col-4">

    <%# Sprint details %>
    <div class="card p-3 mb-3">
      <h5 class="fw-semibold mb-3">Sprint Details</h5>
      <table class="table w-100 is-borderless fs-7">
        <tr><th>Project</th><td><%= link_to @project.name, @project %></td></tr>
        <tr><th>Status</th><td><%= @sprint.status.humanize %></td></tr>
        <tr><th>Start</th><td><%= @sprint.start_date.strftime("%d %b %Y") %></td></tr>
        <tr><th>End</th><td><%= @sprint.end_date.strftime("%d %b %Y") %></td></tr>
        <tr><th>Duration</th><td><%= @sprint.duration_days %> days</td></tr>
        <% if @sprint.velocity.present? %>
          <tr><th>Velocity</th><td><%= @sprint.velocity %> pts</td></tr>
        <% end %>
        <tr><th>Tickets</th><td><%= @tickets.count %></td></tr>
        <tr><th>Done</th><td><%= @tickets.select { |t| %w[done closed].include?(t.status) }.count %></td></tr>
      </table>
    </div>

    <%# Meetings %>
    <div class="card p-3 mb-3">
      <h5 class="fw-semibold mb-3">📅 Meetings (<%= @meetings.count %>)</h5>
      <% if @meetings.any? %>
        <% @meetings.each do |meeting| %>
          <div class="d-flex justify-content-between align-items-start py-1 border-bottom">
            <div>
              <p class="fw-semibold fs-7 mb-0"><%= link_to meeting.title.truncate(35), meeting_path(meeting) %></p>
              <p class="text-muted fs-7 mb-0"><%= meeting.scheduled_at.strftime("%d %b, %H:%M") %></p>
            </div>
            <%= status_tag(meeting.status) %>
          </div>
        <% end %>
      <% else %>
        <p class="text-muted fs-7">No meetings linked to this sprint.</p>
      <% end %>
      <div class="mt-2">
        <%= link_to "Schedule Meeting", new_meeting_path(sprint_id: @sprint.id), class: "btn btn-outline-primary btn-sm w-100" %>
      </div>
    </div>

  </div><%# /col-4 %>
</div>
