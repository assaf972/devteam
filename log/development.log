    <!-- ══════════════════════════ CHAPTER 11 — ERROR MONITORING ══════════════════════ -->
    <div class="chapter" id="monitoring">
      <div class="chapter-header">
        <div class="chapter-icon red">🚨</div>
        <div>
          <div class="chapter-num">Chapter 11</div>
          <div class="chapter-title">Exception Monitoring — Self-hosted Sentry</div>
        </div>
      </div>

      <p>Exception monitoring catches unhandled errors in running production applications, capturing the full stack trace, request context, user info and environment, then notifies the team instantly. For an on-prem stack we need a <strong>self-hosted solution</strong> with no data leaving the network.</p>

      <div class="tool-grid">
        <div class="tool-card red">
          <div class="tool-logo">🚨</div>
          <div class="tool-name">Sentry (self-hosted)</div>
          <div class="tool-type">Primary Recommendation · All Stacks</div>
          <p class="tool-desc">The industry-standard error monitoring platform. The open-source <code>getsentry/self-hosted</code> Docker Compose stack runs entirely on-prem. Supports Rails, .NET, Node.js/Bun with official SDKs. Full web UI, issue grouping, release tracking, alerting and performance tracing.</p>
        </div>
        <div class="tool-card orange">
          <div class="tool-logo">🪲</div>
          <div class="tool-name">Errbit</div>
          <div class="tool-type">Lightweight · Airbrake-compatible · Rails</div>
          <p class="tool-desc">A self-hosted, open-source Airbrake-compatible error catcher written in Rails. Minimal footprint (~256 MB RAM). Uses the standard <code>airbrake</code> gem — drop-in replacement if you already use Airbrake SaaS.</p>
        </div>
        <div class="tool-card blue">
          <div class="tool-logo">💡</div>
          <div class="tool-name">GlitchTip</div>
          <div class="tool-type">Sentry-Compatible · Lower Resource Use</div>
          <p class="tool-desc">A Sentry-protocol-compatible server written in Django. Lighter than self-hosted Sentry (~512 MB vs ~3 GB RAM). All Sentry SDKs work against it without modification — just point <code>SENTRY_DSN</code> at your GlitchTip instance.</p>
        </div>
      </div>

      <h2>On-Prem Comparison</h2>
      <table>
        <thead>
          <tr><th>Tool</th><th>RAM (min)</th><th>SDK Compatibility</th><th>Multi-stack</th><th>Best For</th></tr>
        </thead>
        <tbody>
          <tr><td><strong>Sentry self-hosted</strong></td><td>3 GB+</td><td>Official Sentry SDKs</td><td><span class="badge badge-green">Yes</span></td><td>Teams with multiple stacks &amp; high volume</td></tr>
          <tr><td><strong>GlitchTip</strong></td><td>512 MB</td><td>All Sentry SDKs</td><td><span class="badge badge-green">Yes</span></td><td>Smaller teams wanting lighter footprint</td></tr>
          <tr><td><strong>Errbit</strong></td><td>256 MB</td><td>Airbrake gem / API</td><td><span class="badge badge-orange">Ruby only</span></td><td>Ruby-only shops already using Airbrake</td></tr>
        </tbody>
      </table>

      <h2>Deploy Sentry Self-Hosted (Docker)</h2>
      <pre><span class="lang-label">bash</span><code><span class="c"># Requirements: 4 CPU, 8 GB RAM, 20 GB disk</span>
git clone https://github.com/getsentry/self-hosted.git sentry
cd sentry

<span class="c"># Interactive installer — sets secrets, prompts for admin email/password</span>
./install.sh

<span class="c"># Start all services (Redis, Postgres, Kafka, Sentry web + worker)</span>
docker compose up -d

<span class="c"># Web UI: http://sentry.yourcompany.local:9000</span>
<span class="c"># Create one Project per stack → each gets its own DSN string</span>
</code></pre>

      <div class="callout warning">
        <span class="callout-icon">⚠️</span>
        <p><strong>Windows Server:</strong> The Sentry installer requires a Linux shell. Run it inside WSL2: <code>wsl bash install.sh</code>. Docker Desktop (WSL2 backend) handles all containers.</p>
      </div>

      <h2>Rails Integration</h2>
      <pre><span class="lang-label">ruby (Gemfile)</span><code>gem <span class="s">"sentry-ruby"</span>
gem <span class="s">"sentry-rails"</span>
gem <span class="s">"sentry-sidekiq"</span>   <span class="c"># add if using Sidekiq / Solid Queue workers</span>
</code></pre>

      <pre><span class="lang-label">ruby</span><code><span class="c"># config/initializers/sentry.rb</span>
<span class="m">Sentry</span>.init <span class="k">do</span> |config|
  config.dsn = <span class="m">ENV</span>[<span class="s">"SENTRY_DSN"</span>]           <span class="c"># from your Sentry project page</span>
  config.breadcrumbs_logger   = [:active_support_logger, :http_logger]
  config.traces_sample_rate   = <span class="n">0.1</span>          <span class="c"># 10% of requests for perf tracing</span>
  config.send_default_pii     = <span class="k">false</span>         <span class="c"># never send passwords / tokens</span>
  config.environment          = <span class="m">Rails</span>.env
  config.ignore_environments  = %w[development test]
<span class="k">end</span>
</code></pre>

      <pre><span class="lang-label">ruby (ApplicationController)</span><code><span class="k">class</span> <span class="m">ApplicationController</span> &lt; <span class="m">ActionController</span>::<span class="m">Base</span>
  before_action :set_sentry_context

  <span class="k">private

  def</span> <span class="m">set_sentry_context</span>
    <span class="k">return unless</span> current_user
    <span class="m">Sentry</span>.set_user(id: current_user.id, email: current_user.email)
    <span class="m">Sentry</span>.set_tags(environment: <span class="m">Rails</span>.env, version: <span class="m">ENV</span>[<span class="s">"APP_VERSION"</span>])
  <span class="k">end</span>
<span class="k">end</span>
</code></pre>

      <h2>ASP.NET Core (.NET 6/7/8) Integration</h2>
      <pre><span class="lang-label">xml (MyApi.csproj)</span><code>&lt;PackageReference Include=<span class="s">"Sentry.AspNetCore"</span> Version=<span class="s">"4.12.1"</span> /&gt;
</code></pre>

      <pre><span class="lang-label">csharp (Program.cs)</span><code>builder.WebHost.UseSentry(options =&gt;
{
    options.Dsn              = <span class="m">Environment</span>.GetEnvironmentVariable(<span class="s">"SENTRY_DSN"</span>);
    options.TracesSampleRate = 0.1;
    options.Debug            = builder.Environment.IsDevelopment();
    options.AttachStacktrace = <span class="k">true</span>;
    options.SendDefaultPii   = <span class="k">false</span>;  <span class="c">// do not send passwords / request bodies</span>
    options.Release          = <span class="m">Assembly</span>.GetEntryAssembly()?
                                        .GetName().Version?.ToString();
});
</code></pre>

      <h2>Legacy .NET Framework 4.x Integration</h2>
      <pre><span class="lang-label">xml (packages.config)</span><code>&lt;package id=<span class="s">"Sentry"</span>         version=<span class="s">"4.12.1"</span> targetFramework=<span class="s">"net48"</span> /&gt;
</code></pre>

      <pre><span class="lang-label">csharp (Global.asax.cs)</span><code><span class="k">public class</span> <span class="m">MvcApplication</span> : <span class="m">HttpApplication</span>
{
    <span class="k">private</span> <span class="m">IDisposable</span> _sentry;

    <span class="k">protected void</span> Application_Start()
    {
        _sentry = <span class="m">SentrySdk</span>.Init(options =&gt;
        {
            options.Dsn              = <span class="m">ConfigurationManager</span>.AppSettings[<span class="s">"SentryDsn"</span>];
            options.AttachStacktrace = <span class="k">true</span>;
            options.TracesSampleRate = 0.05;
        });
    }

    <span class="c">// Catch any unhandled exception at the ASP.NET pipeline level</span>
    <span class="k">protected void</span> Application_Error()
        => <span class="m">SentrySdk</span>.CaptureException(Server.GetLastError());

    <span class="k">protected void</span> Application_End() => _sentry?.Dispose();
}
</code></pre>

      <h2>Node.js / Bun Integration</h2>
      <pre><span class="lang-label">bash</span><code><span class="c"># npm</span>
npm install @sentry/node @sentry/profiling-node

<span class="c"># Bun (drop-in)</span>
bun add @sentry/node @sentry/profiling-node
</code></pre>

      <pre><span class="lang-label">javascript (instrument.js — import FIRST)</span><code><span class="k">import</span> * <span class="k">as</span> <span class="m">Sentry</span> <span class="k">from</span> <span class="s">"@sentry/node"</span>;
<span class="k">import</span> { nodeProfilingIntegration } <span class="k">from</span> <span class="s">"@sentry/profiling-node"</span>;

<span class="m">Sentry</span>.init({
  dsn:                process.env.<span class="v">SENTRY_DSN</span>,
  environment:        process.env.<span class="v">NODE_ENV</span> ?? <span class="s">"production"</span>,
  tracesSampleRate:   0.1,
  profilesSampleRate: 0.1,
  integrations:       [nodeProfilingIntegration()],
  sendDefaultPii:     false,  <span class="c">// never forward user passwords</span>
});
</code></pre>

      <pre><span class="lang-label">javascript (Express / Hono — register error handler last)</span><code><span class="c">// Must be added AFTER all routes</span>
app.use(<span class="m">Sentry</span>.expressErrorHandler());

<span class="c">// Manually capture anywhere in code:</span>
<span class="k">try</span> {
  <span class="k">await</span> riskyOperation();
} <span class="k">catch</span> (err) {
  <span class="m">Sentry</span>.captureException(err, {
    user: { id: req.user?.id, email: req.user?.email },
    tags: { feature: <span class="s">"ticket-sync"</span> },
  });
  <span class="k">throw</span> err;
}
</code></pre>

      <h2>Sentry DSN per project</h2>
      <pre><span class="lang-label">bash (.env)</span><code><span class="c"># Each Sentry Project (create one per app) has its own DSN</span>
<span class="v">SENTRY_DSN</span>=<span class="s">https://&lt;public_key&gt;@sentry.yourcompany.local/&lt;project_id&gt;</span>

<span class="c"># Example — Rails app uses project 1, ASP.NET uses project 2, Node uses project 3</span>
<span class="c"># The host is your self-hosted Sentry or GlitchTip URL — no data leaves on-prem</span>
</code></pre>

      <div class="callout success">
        <span class="callout-icon">✅</span>
        <p><strong>Alert routing:</strong> In Sentry go to <em>Settings → Integrations → Slack</em> (or Email). Create an Alert Rule: <em>"When a new issue is first seen → notify #dev-alerts"</em>. Add a second rule: <em>"When an issue occurs &gt; 10 times in 1 hour → page on-call"</em>.</p>
      </div>
    </div>

    <!-- ══════════════════════════ CHAPTER 11b — ERRBIT / GLITCHTIP ══════════════════════ -->
    <div class="chapter" id="monitoring-errbit">
      <div class="chapter-header">
        <div class="chapter-icon orange">🪲</div>
        <div>
          <div class="chapter-num">Chapter 11b</div>
          <div class="chapter-title">Lightweight Alternatives — Errbit &amp; GlitchTip</div>
        </div>
      </div>

      <p>If Sentry''s resource requirements (3 GB RAM, Kafka, Redis, Postgres) are too heavy for your server, these two lighter options are full on-prem alternatives.</p>

      <h2>Option A — Errbit (Airbrake-compatible, ~256 MB RAM)</h2>
      <pre><span class="lang-label">yaml (docker-compose.errbit.yml)</span><code>version: <span class="s">"3.9"</span>
services:
  errbit:
    image: errbit/errbit:latest
    ports: [<span class="s">"8081:8080"</span>]
    environment:
      MONGO_URL:        mongodb://mongo:27017/errbit
      ERRBIT_HOST:      errbit.yourcompany.local
      RACK_ENV:         production
      SECRET_KEY_BASE:  <span class="s">${ERRBIT_SECRET}</span>
    depends_on: [mongo]
    restart: unless-stopped

  mongo:
    image: mongo:6
    volumes: [errbit_db:/data/db]
    restart: unless-stopped

volumes:
  errbit_db:
</code></pre>

      <pre><span class="lang-label">bash</span><code>docker compose -f docker-compose.errbit.yml up -d

<span class="c"># Bootstrap admin user</span>
docker compose exec errbit bundle exec rake errbit:bootstrap
</code></pre>

      <pre><span class="lang-label">ruby (config/initializers/airbrake.rb)</span><code><span class="m">Airbrake</span>.configure <span class="k">do</span> |config|
  config.host        = <span class="s">"http://errbit.yourcompany.local:8081"</span>
  config.project_id  = <span class="n">1</span>                        <span class="c"># from Errbit project page</span>
  config.project_key = <span class="m">ENV</span>[<span class="s">"ERRBIT_API_KEY"</span>]   <span class="c"># from Errbit project page</span>
  config.environment = <span class="m">Rails</span>.env
  config.ignore_environments = %w[development test]
<span class="k">end</span>
</code></pre>

      <h2>Option B — GlitchTip (Sentry-compatible, ~512 MB RAM)</h2>
      <div class="callout info">
        <span class="callout-icon">ℹ️</span>
        <p>GlitchTip speaks the Sentry wire protocol. Use <strong>any official Sentry SDK unchanged</strong> — just point <code>SENTRY_DSN</code> at your GlitchTip server. No SDK code changes required.</p>
      </div>

      <pre><span class="lang-label">yaml (docker-compose.glitchtip.yml)</span><code>version: <span class="s">"3.9"</span>
x-environment: &amp;env
  SECRET_KEY:        <span class="s">${GLITCHTIP_SECRET}</span>
  DATABASE_URL:      postgresql://postgres:postgres@postgres/postgres
  REDIS_URL:         redis://redis:6379/0
  GLITCHTIP_DOMAIN:  <span class="s">"https://glitchtip.yourcompany.local"</span>
  EMAIL_URL:         <span class="s">"smtp://mailhost:25"</span>

services:
  web:
    image: glitchtip/glitchtip
    ports: [<span class="s">"8082:8080"</span>]
    environment: *env
    depends_on: [postgres, redis]
    restart: unless-stopped

  worker:
    image: glitchtip/glitchtip
    command: ./bin/run-celery-with-beat.sh
    environment: *env
    depends_on: [postgres, redis]
    restart: unless-stopped

  postgres:
    image: postgres:16
    environment: { POSTGRES_PASSWORD: postgres }
    volumes: [glitchtip_pg:/var/lib/postgresql/data]

  redis:
    image: redis:7-alpine

volumes:
  glitchtip_pg:
</code></pre>

      <pre><span class="lang-label">bash</span><code>docker compose -f docker-compose.glitchtip.yml up -d

<span class="c"># Create admin user</span>
docker compose exec web python manage.py createsuperuser

<span class="c"># Open http://glitchtip.yourcompany.local:8082</span>
<span class="c"># Create an Organisation → create a Project per stack → copy the DSN</span>
<span class="c"># Paste DSN into SENTRY_DSN env var — all existing Sentry SDK code works as-is</span>
</code></pre>

