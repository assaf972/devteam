<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DevTeam Hub – מצגת המוצר</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <style>
    :root {
      --navy:   #0d1b2a;
      --dark:   #1a1d2e;
      --blue:   #4a90d9;
      --blue2:  #74b0f0;
      --green:  #38c96d;
      --red:    #e84545;
      --orange: #f5a623;
      --purple: #7b68ee;
      --text:   #2d3748;
      --muted:  #718096;
      --border: #e2e8f0;
      --bg:     #f8f9fb;
    }
    *  { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: ''Heebo'', ''Arial Hebrew'', Arial, sans-serif;
      direction: rtl;
      background: #fff;
      color: var(--text);
      line-height: 1.65;
    }

    /* ── TOP NAV ─────────────────────────────────────────────────────────── */
    .top-nav {
      position: sticky; top: 0; z-index: 200;
      background: var(--dark);
      display: flex; align-items: center;
      padding: 0 2rem; height: 54px; gap: 0.25rem;
      box-shadow: 0 2px 12px rgba(0,0,0,0.25);
    }
    .top-nav .brand {
      font-size: 1rem; font-weight: 900; color: #fff;
      text-decoration: none; margin-left: 1.5rem; flex-shrink: 0;
      letter-spacing: -0.02em;
    }
    .top-nav .brand span { color: var(--blue2); }
    .top-nav a {
      color: rgba(255,255,255,0.65); text-decoration: none;
      font-size: 0.78rem; padding: 0.3rem 0.65rem;
      border-radius: 4px; white-space: nowrap;
      transition: background .15s, color .15s;
    }
    .top-nav a:hover { background: rgba(255,255,255,0.1); color: #fff; }

    /* ── HERO ────────────────────────────────────────────────────────────── */
    .hero {
      background: linear-gradient(150deg, #0a1628 0%, #1a2f5a 55%, #1e3a6e 100%);
      color: #fff; text-align: center;
      padding: 7rem 2rem 6rem;
    }
    .hero-logo {
      display: inline-flex; align-items: center; gap: 0.6rem;
      background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.15);
      border-radius: 12px; padding: 0.5rem 1.2rem;
      font-size: 0.85rem; font-weight: 700; color: var(--blue2);
      margin-bottom: 2rem; letter-spacing: 0.04em;
    }
    .hero h1 {
      font-size: 3.2rem; font-weight: 900;
      margin-bottom: 1.25rem; line-height: 1.2;
    }
    .hero h1 .accent { color: var(--blue2); }
    .hero .subtitle {
      font-size: 1.15rem; opacity: .80;
      max-width: 680px; margin: 0 auto 3rem;
      line-height: 1.8;
    }
    .hero-stats {
      display: flex; justify-content: center;
      gap: 2.5rem; flex-wrap: wrap;
      border-top: 1px solid rgba(255,255,255,0.12);
      padding-top: 2.5rem; margin-top: 1rem;
    }
    .hero-stat .num { font-size: 2.4rem; font-weight: 900; color: var(--blue2); display: block; }
    .hero-stat .lbl { font-size: 0.82rem; opacity: .65; margin-top: .15rem; }

    /* ── SECTION WRAPPERS ─────────────────────────────────────────────────── */
    .section       { max-width: 1080px; margin: 0 auto; padding: 5rem 2rem; }
    .section-full  { padding: 5rem 3rem; }
    .section-dark  { background: var(--dark); }
    .section-navy  { background: var(--navy); }
    .section-blue  { background: linear-gradient(135deg, #0f1f3d 0%, #1a3a6e 100%); }
    .section-alt   { background: var(--bg); }

    /* ── TITLES ──────────────────────────────────────────────────────────── */
    .section-badge {
      display: inline-block; background: var(--blue);
      color: #fff; font-size: 0.7rem; font-weight: 700;
      padding: .2rem .7rem; border-radius: 3px;
      letter-spacing: .06em; text-transform: uppercase;
      margin-bottom: .6rem;
    }
    .section-dark  .section-badge,
    .section-navy  .section-badge,
    .section-blue  .section-badge { background: rgba(74,144,217,0.3); color: var(--blue2); }

    .section-title {
      font-size: 1.9rem; font-weight: 800; margin-bottom: .4rem; color: var(--dark);
    }
    .section-dark  .section-title,
    .section-navy  .section-title,
    .section-blue  .section-title { color: #fff; }

    .section-sub {
      font-size: .95rem; color: var(--muted); margin-bottom: 2.5rem; max-width: 650px;
    }
    .section-dark  .section-sub,
    .section-navy  .section-sub,
    .section-blue  .section-sub { color: rgba(255,255,255,.6); }

    /* ── TOC ─────────────────────────────────────────────────────────────── */
    .toc-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: .85rem; margin-top: 1.5rem;
    }
    .toc-item {
      display: flex; align-items: center; gap: .75rem;
      padding: .9rem 1.1rem; background: #fff;
      border: 1.5px solid var(--border); border-radius: 8px;
      text-decoration: none; color: var(--text);
      font-size: .87rem; font-weight: 500;
      transition: border-color .15s, box-shadow .15s, transform .15s;
    }
    .toc-item:hover {
      border-color: var(--blue);
      box-shadow: 0 4px 14px rgba(74,144,217,.18);
      transform: translateY(-2px);
    }
    .toc-num {
      width: 28px; height: 28px; background: var(--dark); color: #fff;
      border-radius: 6px; display: flex; align-items: center; justify-content: center;
      font-size: .75rem; font-weight: 800; flex-shrink: 0;
    }

    /* ── CARDS ───────────────────────────────────────────────────────────── */
    .cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(245px, 1fr));
      gap: 1.25rem; margin-top: 1.5rem;
    }
    .card {
      background: #fff; border: 1.5px solid var(--border);
      border-radius: 10px; padding: 1.35rem;
      transition: box-shadow .2s, transform .2s;
    }
    .card:hover { box-shadow: 0 8px 28px rgba(0,0,0,.1); transform: translateY(-3px); }
    .card-icon   { font-size: 1.8rem; margin-bottom: .65rem; }
    .card-title  { font-size: 1rem; font-weight: 700; margin-bottom: .4rem; color: var(--dark); }
    .card-desc   { font-size: .85rem; color: var(--muted); line-height: 1.65; }

    .card-dark {
      background: rgba(255,255,255,.04);
      border-color: rgba(255,255,255,.1);
    }
    .card-dark .card-title { color: #fff; }
    .card-dark .card-desc  { color: rgba(255,255,255,.6); }

    /* ── TABLES ──────────────────────────────────────────────────────────── */
    .styled-table { width: 100%; border-collapse: collapse; margin-top: 1.25rem; font-size: .88rem; }
    .styled-table th {
      background: var(--dark); color: #fff;
      padding: .7rem 1rem; text-align: right; font-weight: 600;
    }
    .styled-table td {
      padding: .65rem 1rem; border-bottom: 1px solid var(--border); text-align: right;
    }
    .styled-table tr:nth-child(even) td { background: #f9fafc; }
    .styled-table tr:hover td { background: #ebf4ff; }

    /* ── BADGES ──────────────────────────────────────────────────────────── */
    .badge {
      display: inline-block; padding: 2px 9px; border-radius: 12px;
      font-size: .71rem; font-weight: 700;
    }
    .badge-green  { background: #c6f6d5; color: #276749; }
    .badge-red    { background: #fed7d7; color: #c53030; }
    .badge-yellow { background: #fefcbf; color: #975a16; }
    .badge-blue   { background: #bee3f8; color: #2c5282; }
    .badge-grey   { background: #e2e8f0; color: #4a5568; }
    .badge-purple { background: #e9d8fd; color: #553c9a; }

    /* ── ARCHITECTURE DIAGRAM ────────────────────────────────────────────── */
    .arch { background: var(--bg); border: 1.5px solid var(--border); border-radius: 12px; padding: 2rem; margin-top: 1.5rem; }
    .arch-row { display: flex; gap: .75rem; flex-wrap: wrap; align-items: center; margin-bottom: .8rem; }
    .arch-label { font-size: .68rem; text-transform: uppercase; letter-spacing: .07em; color: var(--muted); font-weight: 700; flex: 0 0 110px; }
    .arch-box {
      padding: .45rem 1rem; border-radius: 7px; font-size: .82rem; font-weight: 600;
      display: inline-flex; align-items: center; gap: .35rem; border: 2px solid;
    }
    .ab-user   { background: #ebf4ff; border-color: #90cdf4; color: #2b6cb0; }
    .ab-app    { background: #f0fff4; border-color: #9ae6b4; color: #276749; }
    .ab-portal { background: #faf5ff; border-color: #d6bcfa; color: #553c9a; }
    .ab-db     { background: #fffaf0; border-color: #fbd38d; color: #c05621; }
    .ab-tool   { background: #fff5f5; border-color: #feb2b2; color: #c53030; }
    .ab-int    { background: #e6fffa; border-color: #81e6d9; color: #276749; }
    .arch-divider { border: none; border-top: 2px dashed var(--border); margin: .9rem 0; }

    /* ── PIPELINE ────────────────────────────────────────────────────────── */
    .pipeline {
      display: flex; align-items: center; justify-content: space-between;
      gap: 0; margin-top: 1.5rem; flex-wrap: wrap;
    }
    .p-step { flex: 1; text-align: center; min-width: 90px; }
    .p-icon {
      width: 54px; height: 54px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.4rem; margin: 0 auto .5rem; border: 3px solid;
    }
    .p-label    { font-size: .78rem; font-weight: 700; color: var(--dark); }
    .p-sublabel { font-size: .7rem; color: var(--muted); margin-top: .15rem; }
    .p-arrow    { font-size: 1.3rem; color: #ccc; flex-shrink: 0; padding: 0 .25rem; }

    /* ── SECURITY LAYERS ─────────────────────────────────────────────────── */
    .sec-layers { display: flex; flex-direction: column; gap: .7rem; margin-top: 1.5rem; }
    .sec-layer {
      display: flex; align-items: center; gap: 1rem;
      padding: .85rem 1.2rem; border-radius: 8px;
      background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.1);
    }
    .sec-layer-icon { font-size: 1.25rem; flex-shrink: 0; }
    .sec-layer-info { flex: 1; }
    .sec-layer-title { font-size: .9rem; font-weight: 700; color: #fff; }
    .sec-layer-desc  { font-size: .77rem; color: rgba(255,255,255,.55); margin-top: .1rem; }
    .sec-bar { width: 120px; flex-shrink: 0; }
    .sec-bar-track { background: rgba(255,255,255,.12); border-radius: 4px; height: 6px; }
    .sec-bar-fill  { background: var(--green); border-radius: 4px; height: 6px; }
    .sec-bar-label { font-size: .68rem; color: rgba(255,255,255,.4); text-align: left; margin-top: .2rem; }

    /* ── MOCKUP SCREENS ──────────────────────────────────────────────────── */
    .mockup {
      background: #fff; border: 1.5px solid var(--border);
      border-radius: 10px; overflow: hidden;
      box-shadow: 0 8px 32px rgba(0,0,0,.12); margin-top: 1.25rem;
    }
    .mockup-bar {
      background: var(--dark); padding: .55rem 1rem;
      display: flex; align-items: center; gap: .5rem;
    }
    .mockup-bar .dot { width: 9px; height: 9px; border-radius: 50%; }
    .dot-r { background: #e84545; }
    .dot-y { background: #f5a623; }
    .dot-g { background: #38c96d; }
    .mockup-bar .mt { color: rgba(255,255,255,.5); font-size: .72rem; margin-right: auto; }
    .mockup-wrap { display: flex; min-height: 260px; }
    .mockup-sb {
      width: 170px; background: #1a1d2e; padding: .85rem .65rem; flex-shrink: 0;
    }
    .ms  { font-size: .6rem; text-transform: uppercase; letter-spacing: .07em; color: rgba(255,255,255,.28); padding: .6rem .4rem .1rem; font-weight: 700; }
    .mi  { font-size: .72rem; padding: .25rem .45rem; border-radius: 4px; color: rgba(255,255,255,.55); margin-bottom: .1rem; }
    .mi.a { background: #4a90d9; color: #fff; }
    .mockup-main { flex: 1; padding: 1rem 1.25rem; overflow: hidden; }

    /* ── CHARTS ──────────────────────────────────────────────────────────── */
    .chart-card {
      background: #fff; border: 1.5px solid var(--border);
      border-radius: 10px; padding: 1.5rem; margin-top: 1.25rem;
    }
    .chart-title { font-size: .88rem; font-weight: 700; color: var(--dark); margin-bottom: 1rem; }

    /* ── TWO / THREE COL ─────────────────────────────────────────────────── */
    .two-col   { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; align-items: start; }
    .three-col { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1.5rem; align-items: start; }

    /* ── FEATURE BARS ────────────────────────────────────────────────────── */
    .feat-bar-row { display: flex; align-items: center; gap: .85rem; padding: .55rem 0; border-bottom: 1px solid var(--border); }
    .feat-name { flex: 0 0 165px; font-size: .85rem; font-weight: 600; }
    .feat-track { flex: 1; background: #e2e8f0; height: 8px; border-radius: 4px; overflow: hidden; }
    .feat-fill  { height: 100%; border-radius: 4px; }
    .feat-pct   { flex: 0 0 38px; font-size: .75rem; color: var(--muted); text-align: left; }

    /* ── HIGHLIGHT BOX ───────────────────────────────────────────────────── */
    .highlight-box {
      background: rgba(74,144,217,.08); border: 1.5px solid rgba(74,144,217,.25);
      border-radius: 10px; padding: 1.25rem 1.5rem; margin-top: 1.25rem;
    }
    .highlight-box.green { background: rgba(56,201,109,.08); border-color: rgba(56,201,109,.25); }
    .highlight-box.red   { background: rgba(232,69,69,.07);   border-color: rgba(232,69,69,.2);   }

    /* ── SUMMARY TILES ───────────────────────────────────────────────────── */
    .summary-tile {
      background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.12);
      border-radius: 10px; padding: 1.5rem; text-align: center;
    }
    .summary-tile .s-icon { font-size: 2.2rem; margin-bottom: .6rem; }
    .summary-tile .s-title { font-size: .95rem; font-weight: 700; color: #fff; margin-bottom: .35rem; }
    .summary-tile .s-desc  { font-size: .8rem; color: rgba(255,255,255,.55); line-height: 1.6; }

    /* ── FOOTER ──────────────────────────────────────────────────────────── */
    footer { background: var(--navy); color: rgba(255,255,255,.4); text-align: center; padding: 2rem; font-size: .8rem; }

    @media (max-width: 780px) {
      .hero h1 { font-size: 2rem; }
      .section { padding: 3rem 1.25rem; }
      .two-col, .three-col, .pipeline { grid-template-columns: 1fr; flex-direction: column; }
      .top-nav { overflow-x: auto; }
      .feat-name { flex: 0 0 120px; }
      .arch-label { flex: 0 0 80px; }
      .sec-bar { display: none; }
    }
  </style>
</head>
<body>

