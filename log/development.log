118:                <div class="is-flex is-justify-content-space-between py-1">
119:                  <div>
120:                    <span class="has-text-weight-medium"><%= ms.name %></span>
121:                    <span class="tag is-light is-small ml-1"><%= ms.project.name %></span>
122:                    <span class="tag is-danger is-light is-small ml-1"><%= ms.due_date.strftime("%b %-d") %></span>
123:                  </div>
124:                  <%= status_tag(ms.status) %>
125:                </div>
126:              <% end %>
127:            <% end %>
128:          </div>
129:        <% end %>
130:    
131:        <%# Documents changed today -%>
132:        <div id="section-docs" class="box mb-4">
133:          <h2 class="title is-5 mb-3">📄 <%= t("today.docs_header") %></h2>
134:          <% if @documents_today.empty? %>
135:            <p class="has-text-grey"><%= t("today.no_docs") %></p>
136:          <% else %>
137:            <% @documents_today.each do |doc| %>
138:              <div class="is-flex is-justify-content-space-between py-1" style="border-bottom: 1px solid #f5f5f5;">
139:                <div>
140:                  <%= link_to doc.title, project_document_path(doc.project, doc) %>
141:                  <span class="tag is-light is-small ml-1"><%= doc.project.name %></span>
142:                  <span class="tag is-info is-light is-small ml-1"><%= doc.doc_type.to_s.humanize %></span>
143:                </div>
144:                <span class="has-text-grey is-size-7"><%= doc.author&.display_name %> · <%= l(doc.updated_at, format: :short) %></span>
145:              </div>
146:            <% end %>
147:          <% end %>
148:        </div>
149:    
150:      </div><%# /left column %>
151:    
152:      <%# ── RIGHT COLUMN ───────────────────────────────────────────────────────── %>
153:      <div class="column">
154:    
155:        <%# Meetings today -%>
156:        <div id="section-meetings" class="box mb-4">
157:          <h2 class="title is-5 mb-3">📅 <%= t("today.meetings_header") %></h2>
158:          <% if @meetings_today.empty? %>
159:            <p class="has-text-grey"><%= t("today.no_meetings") %></p>
160:          <% else %>
161:            <% @meetings_today.each do |meeting| %>
162:              <div class="is-flex is-justify-content-space-between is-align-items-center py-2" style="border-bottom:1px solid #f5f5f5;">
163:                <div>
164:                  <p class="has-text-weight-medium mb-0"><%= meeting.title %></p>
165:                  <p class="is-size-7 has-text-grey mb-0">
166:                    <%= l(meeting.scheduled_at, format: :short) %>
167:                    <% if meeting.duration_minutes.present? %>· <%= meeting.duration_minutes %> min<% end %>
168:                    <% if meeting.project.present? %> · <%= meeting.project.name %><% end %>
169:                  </p>
170:                </div>
171:                <div class="is-flex is-align-items-center">
172:                  <%= status_tag(meeting.status) %>
173:                  <% if meeting.jitsi_room.present? && meeting.status != "completed" %>
174:                    <%= link_to "🎥 Join", meeting.jitsi_url, target: "_blank", rel: "noopener", class: "button is-small is-info ml-2" %>
175:                  <% end %>
176:                </div>
177:              </div>
178:            <% end %>
179:          <% end %>
180:        </div>
181:    
182:        <%# CI Runs today -%>
183:        <div id="section-ci" class="box mb-4">
184:          <div class="is-flex is-justify-content-space-between is-align-items-center mb-3">
185:            <h2 class="title is-5 mb-0">⚙️ <%= t("today.ci_header") %></h2>
186:            <% if @jenkins_url.present? %>
187:              <%= link_to "Open Jenkins →", @jenkins_url, target: "_blank", rel: "noopener", class: "button is-small is-dark" %>
188:            <% end %>
189:          </div>
190:    
191:          <%# Failing builds alert -%>
192:          <% if @my_failing_builds.any? %>
193:            <div class="notification is-danger is-light py-2 px-3 mb-3">
194:              <strong>⚠ <%= @my_failing_builds.size %> failing <%= "build".pluralize(@my_failing_builds.size) %></strong>
195:              <% @my_failing_builds.each do |run| %>
196:                <div class="is-flex is-justify-content-space-between is-size-7 mt-1">
197:                  <span><%= run.project.name %> · #<%= run.build_number %> · <%= run.branch_name %></span>
198:                  <% if run.log_url.present? %>
199:                    <%= link_to "View log", run.log_url, target: "_blank", rel: "noopener", class: "has-text-danger" %>
200:                  <% end %>
201:                </div>
202:              <% end %>
203:            </div>
204:          <% end %>
205:    
206:          <% if @my_ci_runs_today.empty? %>
207:            <p class="has-text-grey"><%= t("today.no_ci") %></p>
208:          <% else %>
209:            <% @my_ci_runs_today.each do |run| %>
210:              <div class="is-flex is-justify-content-space-between py-2" style="border-bottom:1px solid #f5f5f5;">
211:                <div>
212:                  <span class="has-text-weight-medium">#<%= run.build_number %></span>
213:                  <span class="has-text-grey is-size-7 ml-1"><%= run.project.name %></span>
214:                  <% if run.branch_name.present? %>
215:                    <code class="is-size-7 ml-1 has-text-grey-dark"><%= run.branch_name %></code>
216:                  <% end %>
217:                  <% if run.test_results.any? %>
218:                    <span class="tag is-light is-small ml-1">
219:                      <%= run.test_results.where(passed: true).count %>✓
220:                      <%= run.test_results.where(passed: false).count %>✗
221:                    </span>
222:                  <% end %>
223:                </div>
224:                <div class="is-flex is-align-items-center">
225:                  <%= status_tag(run.status) %>
226:                  <% if run.log_url.present? %>
227:                    <%= link_to "Log", run.log_url, target: "_blank", rel: "noopener", class: "button is-small is-light ml-1" %>
228:                  <% end %>
229:                </div>
230:              </div>
231:            <% end %>
232:          <% end %>
233:    
234:          <%# Quick links per project -%>
235:          <% if @ci_projects.any? %>
236:            <div class="mt-3 pt-2" style="border-top:1px solid #eee;">
237:              <p class="heading mb-2"><%= t("today.ci_jobs") %></p>
238:              <% @ci_projects.each do |proj| %>
239:                <div class="is-flex is-justify-content-space-between is-size-7 mb-1">
240:                  <span><%= proj.name %></span>
241:                  <span>
242:                    <% job_name = URI.encode_www_form_component(proj.name) %>
243:                    <%= link_to "Jenkins", "#{@jenkins_url}/job/#{job_name}/", target: "_blank", rel: "noopener", class: "tag is-dark" %>
244:                    <% if proj.repo_url.present? %>
245:                      <%= link_to "Repo", proj.repo_url, target: "_blank", rel: "noopener", class: "tag is-primary is-light ml-1" %>
246:                    <% end %>
247:                  </span>
248:                </div>
249:              <% end %>
250:            </div>
251:          <% end %>
252:        </div>
253:    
254:        <%# Deployments today -%>
255:        <div id="section-deploys" class="box mb-4">
256:          <h2 class="title is-5 mb-3">🚀 <%= t("today.deploys_header") %></h2>
257:          <% if @my_deployments_today.empty? %>
258:            <p class="has-text-grey"><%= t("today.no_deploys") %></p>
259:          <% else %>
260:            <% @my_deployments_today.each do |dep| %>
261:              <div class="is-flex is-justify-content-space-between py-2" style="border-bottom:1px solid #f5f5f5;">
262:                <div>
263:                  <span class="has-text-weight-medium"><%= dep.project.name %></span>
264:                  <span class="tag is-light is-small ml-1"><%= dep.environment %></span>
265:                  <span class="tag is-info is-light is-small ml-1">v<%= dep.version %></span>
266:                  <span class="is-size-7 has-text-grey ml-1"><%= dep.deploy_type.to_s.humanize %></span>
267:                </div>
268:                <%= status_tag(dep.status) %>
269:              </div>
270:            <% end %>
271:          <% end %>
272:        </div>
273:    
274:      </div><%# /right column %>
275:    
276:    </div>
  
