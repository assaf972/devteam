<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>DevTeam Hub — Infrastructure & Tooling Guide</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <style>
    :root {
      --brand: #4a90d9;
      --brand-dark: #2c6fac;
      --accent: #e74c3c;
      --green: #27ae60;
      --orange: #e67e22;
      --purple: #8e44ad;
      --dark: #1a1d2e;
      --mid: #2d3250;
      --light-bg: #f8fafc;
      --border: #e2e8f0;
      --code-bg: #0d1117;
      --sidebar-w: 260px;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: ''Inter'', sans-serif; color: #1e293b; background: var(--light-bg); line-height: 1.7; }

    /* ── Sidebar ── */
    .sidebar {
      position: fixed; top: 0; left: 0; width: var(--sidebar-w);
      height: 100vh; background: var(--dark); color: #cbd5e1;
      overflow-y: auto; z-index: 100; padding: 0;
    }
    .sidebar-logo {
      padding: 1.5rem 1.25rem 1rem;
      font-size: 1.1rem; font-weight: 800; color: #fff;
      border-bottom: 1px solid rgba(255,255,255,0.08);
      display: flex; align-items: center; gap: 0.6rem;
    }
    .sidebar-logo .logo-icon { font-size: 1.4rem; }
    .sidebar-section { padding: 1rem 1rem 0.25rem; font-size: 0.65rem; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.1em; color: #64748b; }
    .sidebar a {
      display: flex; align-items: center; gap: 0.6rem;
      padding: 0.5rem 1.25rem; font-size: 0.82rem; color: #94a3b8;
      text-decoration: none; transition: all 0.15s; border-left: 3px solid transparent;
    }
    .sidebar a:hover { color: #fff; background: rgba(255,255,255,0.05); border-left-color: var(--brand); }
    .sidebar a .icon { width: 18px; text-align: center; }

    /* ── Main ── */
    .main { margin-left: var(--sidebar-w); min-height: 100vh; }

    /* ── Hero ── */
    .hero {
      background: linear-gradient(135deg, var(--dark) 0%, var(--mid) 50%, #424769 100%);
      color: #fff; padding: 4rem 3rem 3rem; position: relative; overflow: hidden;
    }
    .hero::before {
      content: ''''; position: absolute; inset: 0;
      background: url("data:image/svg+xml,%3Csvg width=''60'' height=''60'' viewBox=''0 0 60 60'' xmlns=''http://www.w3.org/2000/svg''%3E%3Cg fill=''none'' fill-rule=''evenodd''%3E%3Cg fill=''%234a90d9'' fill-opacity=''0.05''%3E%3Cpath d=''M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z''/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    }
    .hero-eyebrow { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.15em; color: var(--brand); margin-bottom: 0.75rem; }
    .hero h1 { font-size: 2.6rem; font-weight: 800; line-height: 1.15; margin-bottom: 1rem; }
    .hero h1 span { color: var(--brand); }
    .hero p { font-size: 1.1rem; color: #94a3b8; max-width: 640px; margin-bottom: 1.5rem; }
    .hero-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }
    .hero-tag {
      background: rgba(74,144,217,0.15); border: 1px solid rgba(74,144,217,0.3);
      color: #93c5fd; padding: 0.25rem 0.75rem; border-radius: 100px; font-size: 0.78rem; font-weight: 600;
    }

    /* ── TOC ── */
    .toc-grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 1rem; padding: 2rem 3rem; background: #fff; border-bottom: 1px solid var(--border);
    }
    .toc-card {
      border: 1px solid var(--border); border-radius: 12px; padding: 1.25rem;
      text-decoration: none; color: inherit; display: flex; align-items: flex-start;
      gap: 0.875rem; transition: all 0.15s;
    }
    .toc-card:hover { border-color: var(--brand); box-shadow: 0 0 0 3px rgba(74,144,217,0.1); }
    .toc-icon { font-size: 1.6rem; flex-shrink: 0; }
    .toc-title { font-size: 0.9rem; font-weight: 700; }
    .toc-desc { font-size: 0.78rem; color: #64748b; margin-top: 0.2rem; }

    /* ── Content ── */
    .content { padding: 3rem; max-width: 1100px; }

    /* ── Sections ── */
    .chapter { margin-bottom: 4rem; }
    .chapter-header {
      display: flex; align-items: center; gap: 1rem;
      margin-bottom: 2rem; padding-bottom: 1rem;
      border-bottom: 2px solid var(--border);
    }
    .chapter-icon {
      width: 52px; height: 52px; border-radius: 14px;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.6rem; flex-shrink: 0;
    }
    .chapter-icon.blue   { background: #dbeafe; }
    .chapter-icon.green  { background: #dcfce7; }
    .chapter-icon.orange { background: #ffedd5; }
    .chapter-icon.purple { background: #f3e8ff; }
    .chapter-icon.red    { background: #fee2e2; }
    .chapter-icon.teal   { background: #ccfbf1; }
    .chapter-icon.yellow { background: #fef9c3; }
    .chapter-icon.gray   { background: #f1f5f9; }
    .chapter-num { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #94a3b8; }
    .chapter-title { font-size: 1.75rem; font-weight: 800; }

    h2 { font-size: 1.25rem; font-weight: 700; margin: 2rem 0 0.75rem; color: var(--dark); }
    h3 { font-size: 1rem; font-weight: 700; margin: 1.5rem 0 0.5rem; color: #334155; }
    p { margin-bottom: 1rem; color: #475569; }

    /* ── Code blocks ── */
    pre {
      background: var(--code-bg); border-radius: 10px; padding: 1.25rem 1.5rem;
      overflow-x: auto; margin: 1.25rem 0; position: relative;
      border: 1px solid #21262d;
    }
    pre .lang-label {
      position: absolute; top: 0.5rem; right: 0.75rem;
      font-size: 0.65rem; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.08em; color: #6e7681; font-family: ''Fira Code'', monospace;
    }
    code { font-family: ''Fira Code'', monospace; font-size: 0.82rem; line-height: 1.65; }
    pre code { color: #e6edf3; }
    :not(pre) > code {
      background: #f1f5f9; color: #e11d48; padding: 0.15em 0.4em;
      border-radius: 4px; font-size: 0.83em;
    }
    /* Syntax colouring (manual) */
    .k  { color: #ff7b72; } /* keyword */
    .s  { color: #a5d6ff; } /* string */
    .c  { color: #8b949e; font-style: italic; } /* comment */
    .m  { color: #79c0ff; } /* method / class */
    .n  { color: #ffa657; } /* constant / number */
    .p  { color: #e6edf3; } /* punctuation */
    .v  { color: #d2a8ff; } /* variable */

    /* ── Info boxes ── */
    .callout {
      border-radius: 10px; padding: 1rem 1.25rem; margin: 1.25rem 0;
      border-left: 4px solid; display: flex; gap: 0.75rem;
    }
    .callout-icon { font-size: 1.1rem; flex-shrink: 0; margin-top: 0.05rem; }
    .callout p { margin: 0; font-size: 0.9rem; }
    .callout.info    { background: #eff6ff; border-color: var(--brand); }
    .callout.warning { background: #fffbeb; border-color: #f59e0b; }
    .callout.success { background: #f0fdf4; border-color: var(--green); }
    .callout.danger  { background: #fef2f2; border-color: var(--accent); }

    /* ── Tool cards ── */
    .tool-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem; margin: 1.5rem 0; }
    .tool-card {
      border: 1px solid var(--border); border-radius: 14px; padding: 1.5rem;
      background: #fff; position: relative; overflow: hidden;
    }
    .tool-card::before {
      content: ''''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
    }
    .tool-card.blue::before   { background: var(--brand); }
    .tool-card.green::before  { background: var(--green); }
    .tool-card.orange::before { background: var(--orange); }
    .tool-card.purple::before { background: var(--purple); }
    .tool-card.red::before    { background: var(--accent); }
    .tool-card.teal::before   { background: #0d9488; }
    .tool-logo { font-size: 2rem; margin-bottom: 0.75rem; }
    .tool-name { font-size: 1rem; font-weight: 800; margin-bottom: 0.25rem; }
    .tool-type { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #94a3b8; margin-bottom: 0.75rem; }
    .tool-desc { font-size: 0.85rem; color: #64748b; margin: 0; }

    /* ── Architecture diagram ── */
    .arch-diagram {
      background: #fff; border: 1px solid var(--border); border-radius: 14px;
      padding: 2rem; margin: 1.5rem 0; overflow-x: auto;
    }
    .arch-diagram svg { display: block; margin: 0 auto; }

    /* ── Table ── */
    table { width: 100%; border-collapse: collapse; margin: 1.25rem 0; font-size: 0.875rem; }
    th { background: var(--dark); color: #fff; padding: 0.75rem 1rem; text-align: left; font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; }
    td { padding: 0.75rem 1rem; border-bottom: 1px solid var(--border); color: #475569; }
    tr:hover td { background: var(--light-bg); }

    /* ── Badges ── */
    .badge { display: inline-block; padding: 0.2em 0.6em; border-radius: 100px; font-size: 0.72rem; font-weight: 700; }
    .badge-blue   { background: #dbeafe; color: #1d4ed8; }
    .badge-green  { background: #dcfce7; color: #15803d; }
    .badge-orange { background: #ffedd5; color: #c2410c; }
    .badge-purple { background: #f3e8ff; color: #7e22ce; }
    .badge-red    { background: #fee2e2; color: #b91c1c; }

    /* ── Steps ── */
    .steps { counter-reset: step; margin: 1.5rem 0; }
    .step { display: flex; gap: 1rem; margin-bottom: 1.25rem; align-items: flex-start; }
    .step::before {
      counter-increment: step; content: counter(step);
      width: 32px; height: 32px; border-radius: 50%; flex-shrink: 0;
      background: var(--brand); color: #fff; font-size: 0.8rem; font-weight: 800;
      display: flex; align-items: center; justify-content: center;
    }
    .step-body { flex: 1; }
    .step-title { font-weight: 700; font-size: 0.9rem; margin-bottom: 0.25rem; }
    .step-desc { font-size: 0.85rem; color: #64748b; }

    /* ── Chart containers ── */
    .chart-wrap { background: #fff; border: 1px solid var(--border); border-radius: 14px; padding: 1.5rem; margin: 1.5rem 0; }
    .chart-title { font-size: 0.9rem; font-weight: 700; margin-bottom: 1rem; color: var(--dark); }
    canvas { max-height: 280px; }

    /* ── Footer ── */
    footer { background: var(--dark); color: #64748b; padding: 2rem 3rem; font-size: 0.82rem; margin-left: var(--sidebar-w); }
    footer a { color: var(--brand); text-decoration: none; }

    @media(max-width:768px) {
      .sidebar { display: none; }
      .main, footer { margin-left: 0; }
      .content { padding: 1.5rem; }
      .hero { padding: 2rem 1.5rem; }
      .hero h1 { font-size: 1.75rem; }
    }
  </style>
</head>
