      <div class="callout info">
        <span class="callout-icon">ℹ️</span>
        <p>All four stacks share the <strong>same Gherkin <code>.feature</code> file syntax</strong>. You can keep feature files in a central <code>features/</code> folder and run them with the appropriate runner per project. This lets product managers write scenarios once and every tech team runs them.</p>
      </div>
    </div>

    <!-- ── Rails / Ruby ───────────────────────────────────────────────────────── -->
    <div class="chapter" id="testing-rails">
      <div class="chapter-header">
        <div class="chapter-icon green">💎</div>
        <div>
          <div class="chapter-num">Chapter 9a</div>
          <div class="chapter-title">Rails — Cucumber + Capybara + Playwright</div>
        </div>
      </div>

      <p>This project already ships with Cucumber. The recommended driver upgrade is <strong>capybara-playwright-driver</strong> (or <code>selenium-webdriver</code> if you prefer). Tests live in <code>features/</code> with step definitions in <code>features/step_definitions/</code>.</p>

      <h2>Gemfile Setup</h2>
      <pre><span class="lang-label">ruby</span><code><span class="c"># Gemfile — already present, add playwright driver optionally</span>
group :test <span class="k">do</span>
  gem <span class="s">"cucumber-rails"</span>, require: <span class="k">false</span>
  gem <span class="s">"capybara"</span>
  gem <span class="s">"selenium-webdriver"</span>          <span class="c"># Chrome/Firefox headless</span>
  gem <span class="s">"cuprite"</span>                      <span class="c"># alternative: Ferrum/CDP driver</span>
  gem <span class="s">"database_cleaner-active_record"</span>
  gem <span class="s">"factory_bot_rails"</span>
end
</code></pre>

      <h2>features/support/env.rb — Capybara config</h2>
      <pre><span class="lang-label">ruby</span><code>require <span class="s">"capybara/cucumber"</span>

<span class="m">Capybara</span>.register_driver :chrome_headless <span class="k">do</span> |app|
  options = <span class="m">Selenium</span>::<span class="m">WebDriver</span>::<span class="m">Chrome</span>::<span class="m">Options</span>.new
  options.add_argument(<span class="s">"--headless=new"</span>)
  options.add_argument(<span class="s">"--no-sandbox"</span>)
  options.add_argument(<span class="s">"--disable-dev-shm-usage"</span>)
  <span class="m">Capybara</span>::<span class="m">Selenium</span>::<span class="m">Driver</span>.new(app, browser: :chrome, options: options)
<span class="k">end</span>

<span class="m">Capybara</span>.default_driver    = :rack_test      <span class="c"># fast for non-JS</span>
<span class="m">Capybara</span>.javascript_driver = :chrome_headless <span class="c"># JS-heavy scenarios</span>
<span class="m">Capybara</span>.default_max_wait_time = 5
</code></pre>

      <h2>Feature File — Ticket Management</h2>
      <pre><span class="lang-label">gherkin</span><code><span class="c"># features/ticket_management.feature</span>
<span class="k">Feature:</span> Ticket Management
  As a developer on a project
  I want to create and manage tickets
  So that work is tracked and visible to the team

  <span class="k">Background:</span>
    Given I am logged in as <span class="s">"alice@example.com"</span>
    And there is a project called <span class="s">"Alpha"</span>

  <span class="k">Scenario:</span> Create a new ticket
    Given I am on the Alpha project tickets page
    When I click <span class="s">"New Ticket"</span>
    And I fill in <span class="s">"Title"</span> with <span class="s">"Fix login bug"</span>
    And I select <span class="s">"High"</span> from <span class="s">"Priority"</span>
    And I press <span class="s">"Create Ticket"</span>
    Then I should see <span class="s">"Fix login bug"</span> in the tickets list
    And the ticket status should be <span class="s">"open"</span>

  <span class="k">Scenario:</span> Move ticket to In Progress
    Given there is a ticket <span class="s">"Fix login bug"</span> in project <span class="s">"Alpha"</span>
    When I visit the ticket page for <span class="s">"Fix login bug"</span>
    And I click <span class="s">"Start Work"</span>
    Then the ticket status should be <span class="s">"in_progress"</span>
    And I should see a Gitea branch was created
</code></pre>

      <h2>Step Definitions</h2>
      <pre><span class="lang-label">ruby</span><code><span class="c"># features/step_definitions/ticket_steps.rb</span>
Given(<span class="s">/^I am logged in as "([^"]*)"$/</span>) <span class="k">do</span> |email|
  user = <span class="m">FactoryBot</span>.create(:user, email: email)
  visit new_user_session_path
  fill_in <span class="s">"Email"</span>, with: email
  fill_in <span class="s">"Password"</span>, with: <span class="s">"password"</span>
  click_button <span class="s">"Log in"</span>
<span class="k">end</span>

Given(<span class="s">/^I am on the (\w+) project tickets page$/</span>) <span class="k">do</span> |name|
  project = <span class="m">Project</span>.find_by!(name: name)
  visit project_tickets_path(project)
<span class="k">end</span>

When(<span class="s">/^I click "([^"]*)"$/</span>) <span class="k">do</span> |text|
  click_on text
<span class="k">end</span>

When(<span class="s">/^I fill in "([^"]*)" with "([^"]*)"$/</span>) <span class="k">do</span> |field, value|
  fill_in field, with: value
<span class="k">end</span>

Then(<span class="s">/^the ticket status should be "([^"]*)"$/</span>) <span class="k">do</span> |status|
  ticket = <span class="m">Ticket</span>.last
  expect(ticket.status).to eq(status)
<span class="k">end</span>
</code></pre>

      <h2>Running Tests</h2>
      <pre><span class="lang-label">bash</span><code><span class="c"># Run all features</span>
bundle exec cucumber

<span class="c"># Run a specific feature file</span>
bundle exec cucumber features/ticket_management.feature

<span class="c"># Run only scenarios tagged @focus</span>
bundle exec cucumber --tags @focus

<span class="c"># Run headless CI mode (no browser window)</span>
<span class="v">HEADLESS</span>=true bundle exec cucumber

<span class="c"># Generate HTML report</span>
bundle exec cucumber --format html --out reports/cucumber.html
</code></pre>
    </div>

    <!-- ── ASP.NET Core ────────────────────────────────────────────────────────── -->
    <div class="chapter" id="testing-dotnet">
      <div class="chapter-header">
        <div class="chapter-icon purple">🔷</div>
        <div>
          <div class="chapter-num">Chapter 9b</div>
          <div class="chapter-title">ASP.NET Core — SpecFlow + Playwright (.NET 6/7/8)</div>
        </div>
      </div>

      <p><strong>SpecFlow</strong> is the .NET port of Cucumber. It parses the same Gherkin <code>.feature</code> files and generates xUnit/NUnit test cases. <strong>Microsoft.Playwright</strong> (the official .NET library) drives the browser with async/await support and full .NET 6+ compatibility.</p>

      <h2>NuGet Packages</h2>
      <pre><span class="lang-label">xml (MyApi.Tests.csproj)</span><code>&lt;ItemGroup&gt;
  &lt;PackageReference Include=<span class="s">"SpecFlow"</span>                   Version=<span class="s">"3.9.74"</span> /&gt;
  &lt;PackageReference Include=<span class="s">"SpecFlow.xUnit"</span>              Version=<span class="s">"3.9.74"</span> /&gt;
  &lt;PackageReference Include=<span class="s">"SpecFlow.Plus.LivingDocPlugin"</span> Version=<span class="s">"3.9.57"</span> /&gt;
  &lt;PackageReference Include=<span class="s">"Microsoft.Playwright"</span>        Version=<span class="s">"1.44.0"</span> /&gt;
  &lt;PackageReference Include=<span class="s">"Microsoft.Playwright.MSTest"</span>  Version=<span class="s">"1.44.0"</span> /&gt;
  &lt;PackageReference Include=<span class="s">"xunit"</span>                        Version=<span class="s">"2.9.0"</span>  /&gt;
  &lt;PackageReference Include=<span class="s">"xunit.runner.visualstudio"</span>    Version=<span class="s">"2.8.2"</span>  /&gt;
  &lt;PackageReference Include=<span class="s">"Microsoft.AspNetCore.Mvc.Testing"</span> Version=<span class="s">"8.0.0"</span> /&gt;
&lt;/ItemGroup&gt;
</code></pre>

      <h2>One-time Playwright browser install</h2>
      <pre><span class="lang-label">bash</span><code><span class="c"># After restoring NuGet packages, install browser binaries</span>
dotnet tool install --global Microsoft.Playwright.CLI
pwsh bin/Debug/net8.0/playwright.ps1 install chromium firefox
</code></pre>

      <h2>Feature File — Create Ticket</h2>
      <pre><span class="lang-label">gherkin</span><code><span class="c"># Features/TicketManagement.feature</span>
<span class="k">Feature:</span> Ticket Management
  As a developer
  I want to create tickets in DevTeam Hub API
  So that work items are tracked

  <span class="k">Background:</span>
    Given I have a valid API token for user <span class="s">"alice@example.com"</span>
    And a project with slug <span class="s">"alpha"</span> exists

  <span class="k">Scenario:</span> Create a ticket via the REST API
    When I POST to <span class="s">"/api/v1/projects/alpha/tickets"</span> with:
      <span class="s""""""
      {
        "ticket": {
          "title": "Fix login bug",
          "priority": "high"
        }
      }
      """</span>
    Then the response status should be <span class="n">201</span>
    And the response JSON should include <span class="s">"Fix login bug"</span>

  <span class="k">Scenario:</span> View ticket list in browser
    Given I am on the DevTeam Hub login page
    When I log in with <span class="s">"alice@example.com"</span> and password <span class="s">"password"</span>
    And I navigate to project <span class="s">"alpha"</span> tickets
    Then I should see <span class="s">"Fix login bug"</span> on the page
</code></pre>

      <h2>Step Definitions — API scenario</h2>
      <pre><span class="lang-label">csharp</span><code><span class="c">// StepDefinitions/TicketSteps.cs</span>
[<span class="m">Binding</span>]
<span class="k">public class</span> <span class="m">TicketSteps</span>(<span class="m">ScenarioContext</span> ctx, <span class="m">HttpClient</span> http)
{
    [<span class="m">Given</span>(<span class="s">@"I have a valid API token for user (.*)"</span>)]
    <span class="k">public void</span> GivenApiToken(<span class="k">string</span> email)
    {
        <span class="k">var</span> token = TestFixture.GetTokenForEmail(email);
        http.DefaultRequestHeaders.Add(<span class="s">"X-Api-Token"</span>, token);
    }

    [<span class="m">When</span>(<span class="s">@"I POST to (.*) with:"</span>)]
    <span class="k">public async Task</span> WhenIPost(<span class="k">string</span> path, <span class="k">string</span> body)
    {
        <span class="k">var</span> content = <span class="k">new</span> <span class="m">StringContent</span>(body, <span class="m">Encoding</span>.UTF8, <span class="s">"application/json"</span>);
        ctx[<span class="s">"response"</span>] = <span class="k">await</span> http.PostAsync(path, content);
    }

    [<span class="m">Then</span>(<span class="s">@"the response status should be (.*)"</span>)]
    <span class="k">public void</span> ThenStatus(<span class="k">int</span> expected)
    {
        <span class="k">var</span> resp = (<span class="m">HttpResponseMessage</span>)ctx[<span class="s">"response"</span>];
        Assert.Equal((<span class="m">HttpStatusCode</span>)expected, resp.StatusCode);
    }
}
</code></pre>

      <h2>Step Definitions — Browser (Playwright) scenario</h2>
      <pre><span class="lang-label">csharp</span><code><span class="c">// StepDefinitions/BrowserSteps.cs</span>
[<span class="m">Binding</span>]
<span class="k">public class</span> <span class="m">BrowserSteps</span> : <span class="m">IAsyncLifetime</span>
{
    <span class="k">private</span> <span class="m">IPlaywright</span> _pw  = <span class="k">null</span>!;
    <span class="k">private</span> <span class="m">IBrowser</span>    _browser = <span class="k">null</span>!;
    <span class="k">private</span> <span class="m">IPage</span>       _page = <span class="k">null</span>!;

    <span class="k">public async Task</span> InitializeAsync()
    {
        _pw      = <span class="k">await</span> <span class="m">Playwright</span>.CreateAsync();
        _browser = <span class="k">await</span> _pw.Chromium.LaunchAsync(<span class="k">new</span> { Headless = <span class="k">true</span> });
        _page    = <span class="k">await</span> _browser.NewPageAsync();
    }

    [<span class="m">Given</span>(<span class="s">@"I am on the DevTeam Hub login page"</span>)]
    <span class="k">public async Task</span> GivenOnLoginPage()
        => <span class="k">await</span> _page.GotoAsync(<span class="s">"http://localhost:5000/users/sign_in"</span>);

    [<span class="m">When</span>(<span class="s">@"I log in with (.*) and password (.*)"</span>)]
    <span class="k">public async Task</span> WhenILogIn(<span class="k">string</span> email, <span class="k">string</span> password)
    {
        <span class="k">await</span> _page.FillAsync(<span class="s">"input[name=''user[email]'']"</span>, email);
        <span class="k">await</span> _page.FillAsync(<span class="s">"input[name=''user[password]'']"</span>, password);
        <span class="k">await</span> _page.ClickAsync(<span class="s">"input[type=''submit'']"</span>);
    }

    [<span class="m">Then</span>(<span class="s">@"I should see (.*) on the page"</span>)]
    <span class="k">public async Task</span> ThenIShouldSee(<span class="k">string</span> text)
    {
        <span class="k">await</span> <span class="m">Expect</span>(_page.GetByText(text)).ToBeVisibleAsync();
    }

    <span class="k">public async Task</span> DisposeAsync()
    {
        <span class="k">await</span> _browser.CloseAsync();
        _pw.Dispose();
    }
}
</code></pre>

      <h2>Run Tests</h2>
      <pre><span class="lang-label">bash</span><code><span class="c"># Run all SpecFlow scenarios</span>
dotnet test

<span class="c"># Filter by tag</span>
dotnet test --filter "Category=smoke"

<span class="c"># Generate SpecFlow LivingDoc HTML report</span>
dotnet tool run specflow livingdoc test-assembly bin/Debug/net8.0/MyApi.Tests.dll
</code></pre>
    </div>

    <!-- ── Legacy .NET Framework ───────────────────────────────────────────────── -->
    <div class="chapter" id="testing-legacy-dotnet">
      <div class="chapter-header">
        <div class="chapter-icon orange">🪟</div>
        <div>
          <div class="chapter-num">Chapter 9c</div>
          <div class="chapter-title">Legacy .NET Framework — SpecFlow + Selenium WebDriver</div>
        </div>
      </div>

      <p>For projects still on .NET Framework 4.6–4.8 (classic ASP.NET MVC, Web Forms, WCF), <strong>SpecFlow 3.x</strong> with <strong>Selenium WebDriver</strong> is the recommended stack. It integrates with NUnit or MSTest and works without any modern runtime dependencies.</p>

      <div class="callout warning">
        <span class="callout-icon">⚠️</span>
        <p>Use <strong>SpecFlow 3.x</strong> (not 4.x) — SpecFlow 4 requires .NET 6+. Use <strong>Selenium 4.x</strong> with the built-in browser driver manager so you don''t need to manage ChromeDriver versions manually.</p>
      </div>

      <h2>NuGet Packages (packages.config / SDK style)</h2>
      <pre><span class="lang-label">xml</span><code>&lt;packages&gt;
  &lt;package id=<span class="s">"SpecFlow"</span>              version=<span class="s">"3.9.74"</span>  targetFramework=<span class="s">"net48"</span> /&gt;
  &lt;package id=<span class="s">"SpecFlow.NUnit"</span>         version=<span class="s">"3.9.74"</span>  targetFramework=<span class="s">"net48"</span> /&gt;
  &lt;package id=<span class="s">"SpecFlow.Tools.MsBuild.Generation"</span> version=<span class="s">"3.9.74"</span> /&gt;
  &lt;package id=<span class="s">"Selenium.WebDriver"</span>     version=<span class="s">"4.21.0"</span>  targetFramework=<span class="s">"net48"</span> /&gt;
  &lt;package id=<span class="s">"Selenium.Support"</span>        version=<span class="s">"4.21.0"</span>  targetFramework=<span class="s">"net48"</span> /&gt;
  &lt;package id=<span class="s">"Selenium.WebDriver.ChromeDriver"</span> version=<span class="s">"125.0.0"</span> /&gt;
  &lt;package id=<span class="s">"NUnit"</span>                   version=<span class="s">"3.14.0"</span>  targetFramework=<span class="s">"net48"</span> /&gt;
  &lt;package id=<span class="s">"NUnit3TestAdapter"</span>        version=<span class="s">"4.5.0"</span>   /&gt;
&lt;/packages&gt;
</code></pre>

      <h2>Feature File — Dashboard Login (WebForms / MVC app)</h2>
      <pre><span class="lang-label">gherkin</span><code><span class="c"># Features/Dashboard.feature</span>
<span class="k">Feature:</span> Dashboard
  As an internal user
  I want to log in and see my dashboard
  So I can access my daily work items

  <span class="k">Scenario:</span> Successful login
    Given I open the application at <span class="s">"http://intranet.local/login"</span>
    When I enter username <span class="s">"alice"</span> and password <span class="s">"secret"</span>
    And I click the Login button
    Then I should be redirected to the dashboard
    And the page title should contain <span class="s">"Dashboard"</span>

  <span class="k">Scenario Outline:</span> Invalid login attempts
    Given I open the application at <span class="s">"http://intranet.local/login"</span>
    When I enter username <span class="s">"&lt;user&gt;"</span> and password <span class="s">"&lt;pass&gt;"</span>
    And I click the Login button
    Then I should see an error <span class="s">"&lt;error&gt;"</span>

    <span class="k">Examples:</span>
      | user  | pass    | error                   |
      | alice | wrong   | Invalid password        |
      | ghost | secret  | User not found          |
      | alice |         | Password cannot be blank |
</code></pre>

      <h2>Browser Setup Hook</h2>
      <pre><span class="lang-label">csharp</span><code><span class="c">// Support/BrowserHooks.cs</span>
[<span class="m">Binding</span>]
<span class="k">public class</span> <span class="m">BrowserHooks</span>
{
    <span class="k">private static</span> <span class="m">IWebDriver</span> _driver;

    [<span class="m">BeforeScenario</span>]
    <span class="k">public static void</span> BeforeScenario()
    {
        <span class="k">var</span> options = <span class="k">new</span> <span class="m">ChromeOptions</span>();
        options.AddArgument(<span class="s">"--headless=new"</span>);
        options.AddArgument(<span class="s">"--no-sandbox"</span>);
        options.AddArgument(<span class="s">"--disable-dev-shm-usage"</span>);
        _driver = <span class="k">new</span> <span class="m">ChromeDriver</span>(options);
        _driver.Manage().Timeouts().ImplicitWait = <span class="m">TimeSpan</span>.FromSeconds(10);
        <span class="m">ScenarioContext</span>.Current[<span class="s">"driver"</span>] = _driver;
    }

    [<span class="m">AfterScenario</span>]
    <span class="k">public static void</span> AfterScenario() => _driver?.Quit();
}
</code></pre>

      <h2>Step Definitions</h2>
      <pre><span class="lang-label">csharp</span><code><span class="c">// StepDefinitions/LoginSteps.cs</span>
[<span class="m">Binding</span>]
<span class="k">public class</span> <span class="m">LoginSteps</span>
{
    <span class="k">private readonly</span> <span class="m">IWebDriver</span> _driver;

    <span class="k">public</span> LoginSteps(<span class="m">ScenarioContext</span> ctx)
        => _driver = (<span class="m">IWebDriver</span>)ctx[<span class="s">"driver"</span>];

    [<span class="m">Given</span>(<span class="s">@"I open the application at (.*)"</span>)]
    <span class="k">public void</span> GivenIOpenAt(<span class="k">string</span> url) => _driver.Navigate().GoToUrl(url);

    [<span class="m">When</span>(<span class="s">@"I enter username (.*) and password (.*)"</span>)]
    <span class="k">public void</span> WhenIEnter(<span class="k">string</span> user, <span class="k">string</span> pass)
    {
        _driver.FindElement(<span class="m">By</span>.Id(<span class="s">"Username"</span>)).SendKeys(user);
        _driver.FindElement(<span class="m">By</span>.Id(<span class="s">"Password"</span>)).SendKeys(pass);
    }

    [<span class="m">When</span>(<span class="s">@"I click the Login button"</span>)]
    <span class="k">public void</span> WhenIClickLogin()
        => _driver.FindElement(<span class="m">By</span>.CssSelector(<span class="s">"button[type=submit]"</span>)).Click();

    [<span class="m">Then</span>(<span class="s">@"I should be redirected to the dashboard"</span>)]
    <span class="k">public void</span> ThenDashboard()
        => Assert.That(_driver.Url, Does.Contain(<span class="s">"/dashboard"</span>));

    [<span class="m">Then</span>(<span class="s">@"the page title should contain (.*)"</span>)]
    <span class="k">public void</span> ThenTitle(<span class="k">string</span> expected)
        => Assert.That(_driver.Title, Does.Contain(expected));

    [<span class="m">Then</span>(<span class="s">@"I should see an error (.*)"</span>)]
    <span class="k">public void</span> ThenError(<span class="k">string</span> msg)
    {
        <span class="k">var</span> err = _driver.FindElement(<span class="m">By</span>.ClassName(<span class="s">"alert-danger"</span>));
        Assert.That(err.Text, Does.Contain(msg));
    }
}
</code></pre>

