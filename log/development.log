msbuild MyLegacyApp.Tests.sln /p:Configuration=Release
dotnet vstest bin\Release\MyLegacyApp.Tests.dll

<span class="c"># Or from Visual Studio: Test Explorer → Run All</span>
<span class="c"># SpecFlow generates a .feature.cs file for every .feature automatically</span>
</code></pre>
