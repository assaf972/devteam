    <!-- ── Bun / Node.js ──────────────────────────────────────────────────────── -->
    <div class="chapter" id="testing-bun">
      <div class="chapter-header">
        <div class="chapter-icon" style="background:#fef9c3">🟡</div>
        <div>
          <div class="chapter-num">Chapter 9d</div>
          <div class="chapter-title">Bun / Node.js — Cucumber.js + Playwright</div>
        </div>
      </div>

      <p><strong>Cucumber.js</strong> is the official JavaScript implementation of Cucumber. It runs natively in both Node.js and Bun (Bun has built-in Node compatibility). <strong>Playwright</strong>''s Node.js API provides the browser automation layer — it supports Chromium, Firefox and WebKit and is significantly faster than Selenium for JS runtimes.</p>

      <h2>Project Setup (Bun)</h2>
      <pre><span class="lang-label">bash</span><code><span class="c"># Initialise test project (Bun)</span>
bun init -y
bun add -d @cucumber/cucumber @playwright/test playwright

<span class="c"># Install Playwright browsers (one-time)</span>
bunx playwright install chromium firefox

<span class="c"># Or with npm (Node.js)</span>
npm install --save-dev @cucumber/cucumber @playwright/test playwright
npx playwright install
</code></pre>

      <h2>Project Structure</h2>
      <pre><span class="lang-label">text</span><code>my-app-e2e/
├── features/
│   ├── ticket_management.feature   <span class="c"># Gherkin — shared with other stacks!</span>
│   └── dashboard.feature
├── step_definitions/
│   ├── ticket_steps.js
│   └── shared_hooks.js
├── support/
│   └── world.js                    <span class="c"># Playwright browser context</span>
└── cucumber.json
</code></pre>

      <h2>cucumber.json</h2>
      <pre><span class="lang-label">json</span><code>{
  "default": {
    "paths": [<span class="s">"features/**/*.feature"</span>],
    "require": [<span class="s">"support/**/*.js"</span>, <span class="s">"step_definitions/**/*.js"</span>],
    "format": [<span class="s">"progress"</span>, <span class="s">"html:reports/cucumber.html"</span>],
    "parallel": <span class="n">4</span>
  }
}
</code></pre>

      <h2>support/world.js — Playwright context</h2>
      <pre><span class="lang-label">javascript</span><code><span class="k">import</span> { <span class="m">setWorldConstructor</span>, <span class="m">Before</span>, <span class="m">After</span> } <span class="k">from</span> <span class="s">''@cucumber/cucumber''</span>;
<span class="k">import</span> { chromium } <span class="k">from</span> <span class="s">''playwright''</span>;

<span class="k">class</span> <span class="m">PlaywrightWorld</span> {
  async openBrowser() {
    this.browser = <span class="k">await</span> chromium.launch({ headless: <span class="k">true</span> });
    this.context = <span class="k">await</span> this.browser.newContext();
    this.page    = <span class="k">await</span> this.context.newPage();
  }

  async closeBrowser() {
    <span class="k">await</span> this.browser?.close();
  }
}

<span class="m">setWorldConstructor</span>(<span class="m">PlaywrightWorld</span>);

<span class="m">Before</span>(<span class="k">async function</span>() { <span class="k">await</span> this.openBrowser(); });
<span class="m">After</span>(<span class="k">async function</span>() {
  <span class="k">if</span> (this.page &amp;&amp; process.env.<span class="v">SCREENSHOT_ON_FAIL</span>) {
    <span class="k">await</span> this.page.screenshot({ path: <span class="s">`reports/fail-${Date.now()}.png`</span> });
  }
  <span class="k">await</span> this.closeBrowser();
});
</code></pre>

      <h2>Feature File — Ticket Management (shared Gherkin)</h2>
      <pre><span class="lang-label">gherkin</span><code><span class="c"># features/ticket_management.feature  ← identical to Rails version</span>
<span class="k">Feature:</span> Ticket Management
  As a developer on a project
  I want to create and manage tickets
  So that work is tracked and visible to the team

  <span class="k">Scenario:</span> Create a new ticket through the UI
    Given I am on the DevTeam Hub login page
    When I log in as <span class="s">"alice@example.com"</span> with password <span class="s">"password"</span>
    And I navigate to project <span class="s">"Alpha"</span> tickets
    And I click <span class="s">"New Ticket"</span>
    And I fill in <span class="s">"Title"</span> with <span class="s">"Fix login bug"</span>
    And I press <span class="s">"Create Ticket"</span>
    Then I should see <span class="s">"Fix login bug"</span> on the page

  <span class="k">Scenario:</span> Mobile ticket list renders correctly
    Given I open the mobile view at <span class="s">"/mobile/tickets"</span>
    Then the bottom navigation should show 6 tabs
    And the <span class="s">"Tickets"</span> tab should be active
</code></pre>

      <h2>Step Definitions</h2>
      <pre><span class="lang-label">javascript</span><code><span class="c">// step_definitions/ticket_steps.js</span>
<span class="k">import</span> { Given, When, Then } <span class="k">from</span> <span class="s">''@cucumber/cucumber''</span>;
<span class="k">import</span> { expect } <span class="k">from</span> <span class="s">''@playwright/test''</span>;

<span class="k">const</span> <span class="v">BASE</span> = process.env.<span class="v">APP_URL</span> ?? <span class="s">''http://localhost:5000''</span>;

<span class="m">Given</span>(<span class="s">''I am on the DevTeam Hub login page''</span>, <span class="k">async function</span>() {
  <span class="k">await</span> this.page.goto(<span class="s">`${BASE}/users/sign_in`</span>);
});

<span class="m">When</span>(<span class="s">''I log in as {string} with password {string}''</span>, <span class="k">async function</span>(email, password) {
  <span class="k">await</span> this.page.fill(<span class="s">"input[name=''user[email]'']"</span>, email);
  <span class="k">await</span> this.page.fill(<span class="s">"input[name=''user[password]'']"</span>, password);
  <span class="k">await</span> this.page.click(<span class="s">"input[type=''submit'']"</span>);
  <span class="k">await</span> this.page.waitForURL(<span class="s">/dashboard|root/</span>);
});

<span class="m">When</span>(<span class="s">''I navigate to project {string} tickets''</span>, <span class="k">async function</span>(name) {
  <span class="k">await</span> this.page.goto(<span class="s">`${BASE}/projects`</span>);
  <span class="k">await</span> this.page.getByText(name).click();
  <span class="k">await</span> this.page.getByRole(<span class="s">''link''</span>, { name: <span class="s">''Tickets''</span> }).click();
});

<span class="m">When</span>(<span class="s">''I click {string}''</span>, <span class="k">async function</span>(text) {
  <span class="k">await</span> this.page.getByRole(<span class="s">''button''</span>, { name: text })
    .or(this.page.getByRole(<span class="s">''link''</span>, { name: text })).click();
});

<span class="m">When</span>(<span class="s">''I fill in {string} with {string}''</span>, <span class="k">async function</span>(label, value) {
  <span class="k">await</span> this.page.getByLabel(label).fill(value);
});

<span class="m">Then</span>(<span class="s">''I should see {string} on the page''</span>, <span class="k">async function</span>(text) {
  <span class="k">await</span> expect(this.page.getByText(text)).toBeVisible();
});

<span class="m">Then</span>(<span class="s">''the bottom navigation should show {int} tabs''</span>, <span class="k">async function</span>(count) {
  <span class="k">const</span> tabs = <span class="k">await</span> this.page.locator(<span class="s">''.nav-tab''</span>).count();
  expect(tabs).toBe(count);
});

<span class="m">Then</span>(<span class="s">''the {string} tab should be active''</span>, <span class="k">async function</span>(label) {
  <span class="k">await</span> expect(
    this.page.locator(<span class="s">''.nav-tab.is-active''</span>, { hasText: label })
  ).toBeVisible();
});
</code></pre>

      <h2>package.json — test scripts</h2>
      <pre><span class="lang-label">json</span><code>{
  <span class="s">"scripts"</span>: {
    <span class="s">"test"</span>:           <span class="s">"cucumber-js"</span>,
    <span class="s">"test:headed"</span>:    <span class="s">"HEADLESS=false cucumber-js"</span>,
    <span class="s">"test:smoke"</span>:     <span class="s">"cucumber-js --tags @smoke"</span>,
    <span class="s">"test:parallel"</span>:  <span class="s">"cucumber-js --parallel 4"</span>,
    <span class="s">"test:ci"</span>:        <span class="s">"SCREENSHOT_ON_FAIL=1 cucumber-js --format junit:reports/results.xml"</span>
  }
}
</code></pre>

      <h2>Running in CI (Jenkins)</h2>
      <pre><span class="lang-label">groovy (Jenkinsfile)</span><code>stage(<span class="s">''E2E Tests — Bun/Node''</span>) {
  steps {
    sh <span class="s">''bun install''</span>
    sh <span class="s">''bunx playwright install --with-deps chromium''</span>
    sh <span class="s">''APP_URL=http://web:5000 bun run test:ci''</span>
  }
  post {
    always {
      junit <span class="s">''reports/results.xml''</span>
      publishHTML([allowMissing: false, keepAll: true,
        reportDir: <span class="s">''reports''</span>, reportFiles: <span class="s">''cucumber.html''</span>,
        reportName: <span class="s">''Cucumber E2E Report''</span>])
    }
  }
}
</code></pre>

      <div class="callout success">
        <span class="callout-icon">✅</span>
        <p><strong>Bun tip:</strong> Bun runs Cucumber.js ~40% faster than Node.js on cold starts due to its native JS runtime. Use <code>bunx cucumber-js</code> as a drop-in replacement for <code>npx cucumber-js</code>. No config changes needed.</p>
