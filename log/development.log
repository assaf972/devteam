<!-- ══════════════════════════════════════════════════════════════════════
     8. SECURITY
     ══════════════════════════════════════════════════════════════════════ -->
<div id="security" class="section-full section-navy">
<div class="section">
  <div class="section-badge">08 — אבטחה</div>
  <div class="section-title">אבטחת המערכת</div>
  <div class="section-sub">8 שכבות אבטחה המגנות על הנתונים, הגישה והתקשורת בכל רמות המערכת</div>

  <div class="two-col">
    <div class="sec-layers">
      <div class="sec-layer">
        <div class="sec-layer-icon">🔑</div>
        <div class="sec-layer-info">
          <div class="sec-layer-title">אימות (Authentication) — Devise</div>
          <div class="sec-layer-desc">שני מודלי Devise נפרדים: User (צוות פנימי) + CustomerUser (פורטל לקוחות). סיסמאות מוצפנות bcrypt. Password reset מאובטח.</div>
        </div>
        <div class="sec-bar"><div class="sec-bar-track"><div class="sec-bar-fill" style="width:95%"></div></div><div class="sec-bar-label">95%</div></div>
      </div>
      <div class="sec-layer">
        <div class="sec-layer-icon">🛡️</div>
        <div class="sec-layer-info">
          <div class="sec-layer-title">הרשאות (Authorization) — Pundit</div>
          <div class="sec-layer-desc">Pundit policies על כל resource. NotAuthorizedError מיירט כל ניסיון גישה לא מורשה ומפנה עם הודעת שגיאה.</div>
        </div>
        <div class="sec-bar"><div class="sec-bar-track"><div class="sec-bar-fill" style="width:88%"></div></div><div class="sec-bar-label">88%</div></div>
      </div>
      <div class="sec-layer">
        <div class="sec-layer-icon">🔒</div>
        <div class="sec-layer-info">
          <div class="sec-layer-title">CSRF Protection — Rails Built-in</div>
          <div class="sec-layer-desc">כל form ו-AJAX request מאומת עם CSRF token. Turbo ו-Stimulus שולחים X-CSRF-Token אוטומטית.</div>
        </div>
        <div class="sec-bar"><div class="sec-bar-track"><div class="sec-bar-fill" style="width:100%"></div></div><div class="sec-bar-label">100%</div></div>
      </div>
      <div class="sec-layer">
        <div class="sec-layer-icon">🪝</div>
        <div class="sec-layer-info">
          <div class="sec-layer-title">Webhook Validation — HMAC Header</div>
          <div class="sec-layer-desc">כל Webhook מ-Gitea ו-Jenkins מאומת עם secret header. בקשות ללא חתימה תקינה נדחות (403).</div>
        </div>
        <div class="sec-bar"><div class="sec-bar-track"><div class="sec-bar-fill" style="width:90%"></div></div><div class="sec-bar-label">90%</div></div>
      </div>
      <div class="sec-layer">
        <div class="sec-layer-icon">🏰</div>
        <div class="sec-layer-info">
          <div class="sec-layer-title">בידוד פורטל הלקוח</div>
          <div class="sec-layer-desc">CustomerPortal::BaseController יורש מ-ActionController::Base (לא מ-ApplicationController) — אין נגישות למשתנים פנימיים, layouts נפרדים.</div>
        </div>
        <div class="sec-bar"><div class="sec-bar-track"><div class="sec-bar-fill" style="width:95%"></div></div><div class="sec-bar-label">95%</div></div>
      </div>
      <div class="sec-layer">
        <div class="sec-layer-icon">🧹</div>
        <div class="sec-layer-info">
          <div class="sec-layer-title">ניקוי קלט — Strong Parameters</div>
          <div class="sec-layer-desc">כל controller מגדיר permit מפורש לפרמטרים. HTML בהודעות צ''אט עובר ERB::Util.html_escape לפני rendering.</div>
        </div>
        <div class="sec-bar"><div class="sec-bar-track"><div class="sec-bar-fill" style="width:85%"></div></div><div class="sec-bar-label">85%</div></div>
      </div>
      <div class="sec-layer">
        <div class="sec-layer-icon">🕐</div>
        <div class="sec-layer-info">
          <div class="sec-layer-title">ניהול Session — Devise</div>
          <div class="sec-layer-desc">remember_me token מוצפן, timeout session, מחיקת session מאובטחת בהתנתקות. Rails Encrypted Cookies.</div>
        </div>
        <div class="sec-bar"><div class="sec-bar-track"><div class="sec-bar-fill" style="width:90%"></div></div><div class="sec-bar-label">90%</div></div>
      </div>
      <div class="sec-layer">
        <div class="sec-layer-icon">🌐</div>
        <div class="sec-layer-info">
          <div class="sec-layer-title">Modern Browser Enforcement</div>
          <div class="sec-layer-desc">allow_browser versions: :modern דוחה דפדפנים ישנים פגיעים. CSP meta tags מגנים מפני XSS.</div>
        </div>
        <div class="sec-bar"><div class="sec-bar-track"><div class="sec-bar-fill" style="width:80%"></div></div><div class="sec-bar-label">80%</div></div>
      </div>
    </div>
    <div>
      <div class="chart-card" style="background:rgba(255,255,255,.05);border-color:rgba(255,255,255,.1);">
        <div class="chart-title" style="color:#fff;">כיסוי אבטחה לפי שכבה</div>
        <canvas id="securityChart" height="300"></canvas>
      </div>
    </div>
  </div>
</div>
</div>

