<!-- ══════════════════════════════════════════════════════════════════════
     1. OVERVIEW
     ══════════════════════════════════════════════════════════════════════ -->
<section id="overview">
  <div class="section">
    <div class="section-badge">01 — סקירה</div>
    <div class="section-title">מה זה DevTeam Hub?</div>
    <div class="section-sub">פלטפורמת ניהול פיתוח משולבת המאחדת את כל הכלים הנחוצים לצוות פיתוח מקצועי</div>

    <div class="two-col">
      <div>
        <p style="font-size:.95rem;line-height:1.8;color:#4a5568;margin-bottom:1.25rem;">
