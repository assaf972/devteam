<!-- ══════════════════════════════════════════════════════════════════════
     CHARTS
     ══════════════════════════════════════════════════════════════════════ -->
<script>
  Chart.defaults.font.family = "''Heebo'', ''Arial Hebrew'', Arial, sans-serif";
  Chart.defaults.color = ''#718096'';

  // 1. Module coverage — horizontal bar
  new Chart(document.getElementById(''moduleChart''), {
    type: ''bar'',
    data: {
      labels: [''ניהול פרויקטים'', ''כרטיסים'', ''CI/CD'', ''פריסות'', ''מסמכים'', ''פגישות'', ''פורטל לקוחות'', "צ''אט"],
      datasets: [{
        label: ''אחוז כיסוי'',
        data: [95, 92, 90, 88, 85, 78, 83, 75],
        backgroundColor: [''#38c96d'',''#38c96d'',''#38c96d'',''#38c96d'',''#4a90d9'',''#f5a623'',''#4a90d9'',''#f5a623''],
        borderRadius: 5,
      }]
    },
    options: {
      indexAxis: ''y'',
      responsive: true,
      plugins: { legend: { display: false } },
      scales: {
        x: { min: 0, max: 100, ticks: { callback: v => v + ''%'' } },
        y: { ticks: { font: { size: 11 } } }
      }
    }
  });

  // 2. PR activity — bar
  new Chart(document.getElementById(''prChart''), {
    type: ''bar'',
    data: {
      labels: [''ינואר'', ''פברואר'', ''מרץ'', ''אפריל'', ''מאי'', ''יוני''],
      datasets: [
        { label: ''נמזגו'', data: [18,22,19,28,31,24], backgroundColor: ''#38c96d'', borderRadius: 4 },
        { label: ''נסגרו'', data: [3,2,4,2,3,1], backgroundColor: ''#e84545'', borderRadius: 4 }
      ]
    },
    options: {
      responsive: true,
      plugins: { legend: { position: ''bottom'' } },
      scales: { x: { stacked: false }, y: { stacked: false } }
    }
  });

  // 3. CI success rate — line
  new Chart(document.getElementById(''ciChart''), {
