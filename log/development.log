<!-- 11. CI INTEGRATION                                                  -->
<!-- ════════════════════════════════════════════════════════════════════ -->
<div id="ci-integration" class="section">
  <div class="section-title">11. CI Integration — Jenkins &amp; GitHub Actions</div>
  <div class="section-sub">How to connect CI build logs to the unified logging system.</div>

  <div class="two-col">
    <div class="card">
      <h3>Jenkins Pipeline — Loki Log Plugin</h3>
      <pre class="code">// Jenkinsfile — post-build log push
pipeline {
  agent any
  environment {
    LOKI_URL = "http://loki:3100"
  }

  stages {
    stage(''Build'') {
      steps {
        sh ''dotnet build''
      }
    }
    stage(''Test'') {
      steps {
        sh ''dotnet test --logger "trx"''
      }
    }
  }

  post {
    always {
      // Push build log to Loki
      script {
        def logText = currentBuild
          .rawBuild.getLog(1000).join("\n")
        def payload = [
          streams: [[
            stream: [
              service: "jenkins",
              job: env.JOB_NAME,
              build: env.BUILD_NUMBER,
              status: currentBuild.result
            ],
            values: [
              ["${System.nanoTime()}", logText]
            ]
          ]]
        ]
        httpRequest(
          url: "${LOKI_URL}/loki/api/v1/push",
          httpMode: ''POST'',
          contentType: ''APPLICATION_JSON'',
          requestBody:
            groovy.json.JsonOutput
              .toJson(payload)
        )
      }

      // Notify DevTeam Hub
      sh """
        curl -X POST \\
          ${DEVTEAM_URL}/api/v1/logs/push \\
          -H "Authorization: Bearer \${TOKEN}" \\
          -H "Content-Type: application/json" \\
          -d ''{"entries":[{
            "service":"jenkins",
            "level":"info",
            "message":"Build #${BUILD_NUMBER} ${currentBuild.result}"
          }]}''
      """
    }
  }
}</pre>
    </div>
    <div class="card">
      <h3>GitHub Actions — Log Push Step</h3>
      <pre class="code"># .github/workflows/ci.yml
# Add after test job:

  log-results:
    runs-on: ubuntu-latest
    needs: [scan_ruby, lint, test]
    if: always()
    steps:
      - name: Push CI logs to Loki
        env:
          LOKI_URL: ${{ secrets.LOKI_URL }}
          DEVTEAM_TOKEN: ${{ secrets.DEVTEAM_TOKEN }}
        run: |
          STATUS="success"
          if [ "${{ needs.test.result }}" != "success" ]; then
            STATUS="failure"
          fi

          curl -s -X POST \
            "${LOKI_URL}/loki/api/v1/push" \
            -H "Content-Type: application/json" \
            -d "{
              \"streams\": [{
                \"stream\": {
                  \"service\": \"github-actions\",
                  \"repo\": \"${{ github.repository }}\",
                  \"branch\": \"${{ github.ref_name }}\",
                  \"status\": \"${STATUS}\"
                },
                \"values\": [
                  [\"$(date +%s)000000000\",
                   \"CI run ${STATUS} for ${{ github.sha }}\"]
                ]
              }]
            }"</pre>

