  <!-- IMPLEMENTATION                                      -->
  <!-- ═══════════════════════════════════════════════════ -->
  <div class="section" id="implementation">
    <h2><span class="icon">🔧</span> Implementation Guide</h2>

    <h3>Phase 1: Deploy SonarQube (Docker)</h3>
    <h4>docker-compose.sonarqube.yml</h4>
    <pre><code>version: "3.8"
services:
  sonarqube:
    image: sonarqube:community
    container_name: sonarqube
    ports:
      - "9100:9000"
    environment:
      SONAR_ES_BOOTSTRAP_CHECKS_DISABLE: "true"
    volumes:
      - sonarqube_data:/opt/sonarqube/data
      - sonarqube_logs:/opt/sonarqube/logs
      - sonarqube_extensions:/opt/sonarqube/extensions
    restart: unless-stopped
    mem_limit: 2g

volumes:
  sonarqube_data:
  sonarqube_logs:
  sonarqube_extensions:</code></pre>

    <pre><code># Start SonarQube
docker compose -f docker-compose.sonarqube.yml up -d

# Access at http://localhost:9100
# Default login: admin / admin (change immediately!)
# Create a project token for each project in Administration → Security → Tokens</code></pre>

    <h3>Phase 2: Configure SonarQube Projects</h3>
    <p>Create one project per repository in SonarQube:</p>
    <table>
      <thead><tr><th>SonarQube Project Key</th><th>Repo</th><th>Language Profile</th></tr></thead>
      <tbody>
        <tr><td><code>print-server-tdi</code></td><td>Print Server / TDI</td><td>C#, VB.NET</td></tr>
        <tr><td><code>tdi2</code></td><td>TDI2</td><td>C#, JavaScript, SQL</td></tr>
        <tr><td><code>digital-internet-services</code></td><td>Digital Internet Services</td><td>TypeScript, JavaScript</td></tr>
        <tr><td><code>work-management-system</code></td><td>Work Management System</td><td>TypeScript, JavaScript</td></tr>
        <tr><td><code>dev-team-hub</code></td><td>DevTeam Hub</td><td>Ruby, JavaScript, HTML</td></tr>
      </tbody>
    </table>

    <h3>Phase 3: sonar-project.properties (per repository)</h3>

    <h4>DevTeam Hub (Rails)</h4>
    <pre><code># sonar-project.properties — DevTeam Hub
sonar.projectKey=dev-team-hub
sonar.projectName=DevTeam Hub
sonar.projectVersion=1.0

sonar.sources=app,lib,config
sonar.tests=spec,features
sonar.exclusions=vendor/**,node_modules/**,tmp/**,log/**,public/**,storage/**

sonar.ruby.coverage.reportPaths=coverage/.resultset.json
sonar.ruby.rubocop.reportPaths=rubocop-report.json

sonar.javascript.lcov.reportPaths=coverage/lcov.info

sonar.qualitygate.wait=true</code></pre>

