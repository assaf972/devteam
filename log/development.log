  [1m[36mDocument Create (0.7ms)[0m  [1m[32mINSERT INTO "documents" ("author_id", "content", "created_at", "doc_type", "is_template", "project_id", "summary", "template_id", "title", "updated_at", "version_number") VALUES (1, '<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Code Review &amp; Approval Tools — Recommendation &amp; Implementation Guide</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <style>
    :root {
      --bg: #f3f0e8; --panel: #fffdf7; --ink: #12252b; --muted: #5c6f76;
      --line: #d7d0c2; --teal: #0b7a75; --navy: #17324a; --orange: #d26d18;
      --red: #b63a34; --green: #1a7a3a; --purple: #6d28d9; --blue: #4a90d9;
      --shadow: 0 18px 44px rgba(18,37,43,0.09); --radius: 18px;
      --mono: "JetBrains Mono", monospace; --sans: "Manrope", "Segoe UI", sans-serif;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; background: var(--bg); }
    body {
      margin: 0; color: var(--ink); font-family: var(--sans); line-height: 1.6;
      background: radial-gradient(900px 420px at 0% 0%, rgba(11,122,117,0.14), transparent),
                  radial-gradient(760px 340px at 100% 0%, rgba(210,109,24,0.12), transparent), var(--bg);
    }
    .shell { max-width: 1100px; margin: 0 auto; padding: 24px 18px 60px; }

    .topbar {
      position: sticky; top: 0; z-index: 20; background: rgba(255,253,247,0.92);
      border: 1px solid var(--line); border-radius: 16px; backdrop-filter: blur(8px);
      box-shadow: var(--shadow); margin-bottom: 16px; display: flex;
      align-items: center; justify-content: space-between; padding: 10px 22px;
    }
    .topbar-logo { font-weight: 800; font-size: 1.15rem; color: var(--teal); display: flex; align-items: center; gap: 8px; }
    .topbar-logo span { font-size: 1.4rem; }
    .topbar-nav { display: flex; gap: 6px; flex-wrap: wrap; }
    .topbar-nav a { color: var(--muted); font-size: 0.82rem; font-weight: 600; text-decoration: none; padding: 6px 12px; border-radius: 8px; transition: 0.15s; }
    .topbar-nav a:hover { background: rgba(11,122,117,0.08); color: var(--teal); }

    .hero { text-align: center; padding: 48px 18px 32px; }
    .hero h1 { font-size: 2.4rem; font-weight: 800; color: var(--navy); margin: 0 0 10px; }
    .hero p { font-size: 1.05rem; color: var(--muted); max-width: 720px; margin: 0 auto; }

    .section {
      background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius);
      padding: 32px 36px; margin-bottom: 20px; box-shadow: var(--shadow);
    }
    .section h2 { font-size: 1.4rem; font-weight: 800; color: var(--navy); margin: 0 0 10px; display: flex; align-items: center; gap: 10px; }
    .section h2 .icon { font-size: 1.5rem; }
    .section h3 { font-size: 1.05rem; font-weight: 700; color: var(--teal); margin: 24px 0 8px; padding-bottom: 6px; border-bottom: 1px solid var(--line); }
    .section h4 { font-size: 0.95rem; font-weight: 700; color: var(--orange); margin: 18px 0 6px; }
    .section p, .section li { line-height: 1.7; }
    .section ul, .section ol { padding-left: 22px; }

    code { font-family: var(--mono); font-size: 0.86em; background: rgba(11,122,117,0.07); color: var(--teal); padding: 2px 7px; border-radius: 5px; }
    pre { background: #1c2833; color: #e8e6df; font-family: var(--mono); font-size: 0.84rem; padding: 18px 22px; border-radius: 12px; overflow-x: auto; margin: 12px 0 16px; line-height: 1.55; }
    pre code { background: none; padding: 0; color: inherit; }

    .tip { background: rgba(11,122,117,0.06); border-left: 3px solid var(--teal); padding: 14px 18px; border-radius: 0 10px 10px 0; margin: 14px 0; font-size: 0.92rem; }
    .tip strong { color: var(--teal); }
    .warn { background: rgba(210,109,24,0.06); border-left: 3px solid var(--orange); padding: 14px 18px; border-radius: 0 10px 10px 0; margin: 14px 0; font-size: 0.92rem; }
    .warn strong { color: var(--orange); }
    .bad { background: rgba(182,58,52,0.06); border-left: 3px solid var(--red); padding: 14px 18px; border-radius: 0 10px 10px 0; margin: 14px 0; font-size: 0.92rem; }
    .bad strong { color: var(--red); }
    .rec { background: rgba(109,40,217,0.06); border-left: 3px solid var(--purple); padding: 14px 18px; border-radius: 0 10px 10px 0; margin: 14px 0; font-size: 0.92rem; }
    .rec strong { color: var(--purple); }

    table { width: 100%; border-collapse: collapse; margin: 14px 0 8px; }
    th { text-align: left; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); padding: 8px 12px; border-bottom: 2px solid var(--line); }
    td { padding: 10px 12px; border-bottom: 1px solid var(--line); font-size: 0.92rem; vertical-align: top; }
    tr:last-child td { border-bottom: none; }

    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
    @media (max-width: 820px) { .grid-2, .grid-3 { grid-template-columns: 1fr; } .hero h1 { font-size: 2rem; } }

    .tool-card {
      background: var(--panel); border: 1px solid var(--line); border-radius: 14px;
      padding: 22px; transition: 0.2s;
    }
    .tool-card:hover { border-color: var(--teal); transform: translateY(-2px); box-shadow: var(--shadow); }
    .tool-card.winner { border: 2px solid var(--teal); background: rgba(11,122,117,0.03); }
    .tool-card .name { font-size: 1.1rem; font-weight: 800; color: var(--navy); margin-bottom: 4px; }
    .tool-card .tagline { font-size: 0.85rem; color: var(--muted); margin-bottom: 10px; }
    .tool-card .badge { display: inline-block; font-size: 0.72rem; font-weight: 700; padding: 3px 10px; border-radius: 100px; }
    .badge-green { background: rgba(26,122,58,0.12); color: var(--green); }
    .badge-blue { background: rgba(74,144,217,0.12); color: var(--blue); }
    .badge-orange { background: rgba(210,109,24,0.12); color: var(--orange); }
    .badge-red { background: rgba(182,58,52,0.12); color: var(--red); }
    .badge-purple { background: rgba(109,40,217,0.12); color: var(--purple); }
    .badge-teal { background: rgba(11,122,117,0.15); color: var(--teal); }

    .chart-wrap { background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 1.5rem; margin: 1.5rem 0; }
    .chart-title { font-size: 0.9rem; font-weight: 700; margin-bottom: 1rem; color: var(--navy); }
    canvas { max-height: 320px; }

    .verdict-box {
      background: linear-gradient(135deg, rgba(11,122,117,0.08), rgba(109,40,217,0.06));
      border: 2px solid var(--teal); border-radius: 16px; padding: 28px 32px; margin: 20px 0;
      text-align: center;
    }
    .verdict-box .verdict-title { font-size: 1.6rem; font-weight: 800; color: var(--teal); margin-bottom: 8px; }
    .verdict-box .verdict-sub { font-size: 1rem; color: var(--muted); }

    .footer { text-align: center; color: var(--muted); font-size: 0.82rem; padding: 32px 0 12px; }
  </style>
</head>
