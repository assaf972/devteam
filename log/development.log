## 5. Per-Project Jenkinsfile Configurations

### 5.1 Print Server / TDI

**Stack:** C# · .NET Framework · MSBuild · NuGet · NUnit

Add a `Jenkinsfile` at the root of the `print-server-tdi` repository:

```groovy
// Jenkinsfile — Print Server / TDI
pipeline {
    agent { label ''windows'' }

    options {
        timestamps()
        cleanWs()
        buildDiscarder(logRotator(numToKeepStr: ''20''))
    }

    environment {
        SOLUTION_FILE = ''PrintServer.sln''
        NUGET_CONFIG  = ''NuGet.Config''
    }

    stages {
        stage(''Checkout'') {
            steps { checkout scm }
        }

        stage(''Restore NuGet Packages'') {
            steps {
                bat ''nuget restore %SOLUTION_FILE% -ConfigFile %NUGET_CONFIG%''
            }
        }

        stage(''Build'') {
            steps {
                bat """
                    msbuild %SOLUTION_FILE% ^
                        /p:Configuration=Release ^
                        /p:Platform="Any CPU" ^
                        /m /verbosity:minimal
                """
            }
        }

        stage(''Test'') {
            steps {
                bat ''nunit3-console.exe tests\\PrintServer.Tests\\bin\\Release\\PrintServer.Tests.dll --result=TestResults.xml''
            }
            post {
                always { junit ''TestResults.xml'' }
            }
        }

        stage(''Package Installer'') {
            when { branch ''main'' }
            steps {
                bat ''"C:\\Program Files (x86)\\Inno Setup 6\\ISCC.exe" setup\\PrintServer.iss''
                archiveArtifacts artifacts: ''setup/Output/*.exe'', fingerprint: true
            }
        }

        stage(''Notify DevTeam'') {
            steps {
                script {
                    httpRequest(
                        url: env.DEVTEAM_WEBHOOK_URL,
                        httpMode: ''POST'',
                        contentType: ''APPLICATION_JSON'',
                        requestBody: """{"token":"${env.DEVTEAM_WEBHOOK_TOKEN}","ref":"${env.GIT_BRANCH}","status":"${currentBuild.result ?: ''SUCCESS''}","build_url":"${env.BUILD_URL}"}"""
                    )
                }
            }
        }
    }

    post {
        failure { slackSend(color: ''danger'', message: ":x: Print Server / TDI build #${env.BUILD_NUMBER} FAILED — ${env.BUILD_URL}") }
        success { slackSend(color: ''good'',   message: ":white_check_mark: Print Server / TDI build #${env.BUILD_NUMBER} passed") }
    }
}
```

