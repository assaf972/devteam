projects: [
  { name: ''chromium'' },
  { name: ''firefox'' }
],
reporter: [[''junit'', { outputFile: ''playwright-junit.xml'' }]],
use: { trace: ''retain-on-failure'', screenshot: ''only-on-failure'' }</pre>
